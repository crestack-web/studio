{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": ".next",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/initializePayment",
        "function": "initializePayment"
      },
      {
        "source": "/api/verifyPayment",
        "function": "verifyPayment"
      },
      {
        "source": "/api/fetchBankList",
        "function": "fetchBankList"
      },
      {
        "source": "/api/verifyBankAccount",
        "function": "verifyBankAccount"
      },
      {
        "source": "/api/sendAdminSignInLink",
        "function": "sendAdminSignInLink"
      },
      {
        "source": "/api/sendStaffSignInLink",
        "function": "sendStaffSignInLink"
      },
      {
        "source": "/api/sendEmailVerification",
        "function": "sendEmailVerification"
      },
      {
        "source": "/api/sendPasswordReset",
        "function": "sendPasswordReset"
      },
      {
        "source": "/api/claimReferral",
        "function": "claimReferral"
      },
      {
        "source": "/api/ensureReferralCode",
        "function": "ensureReferralCode"
      },
      {
        "source": "/api/adminRecordReferralPayout",
        "function": "adminRecordReferralPayout"
      },
      {
        "source": "/api/createProduct",
        "function": "createProduct"
      },
      {
        "source": "/api/getProducts",
        "function": "getProducts"
      },
      {
        "source": "/api/sendOtpLogin",
        "function": "sendOtpLogin"
      },
      {
        "source": "/api/ask-mo",
        "function": "askMo"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "remoteconfig": {
    "template": "remoteconfig.template.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}