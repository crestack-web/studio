
{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/initializeOneTimePayment",
        "function": "initializeOneTimePayment"
      },
      {
        "source": "/api/initializeSubscription",
        "function": "initializeSubscription"
      },
      {
        "source": "/api/verifyPayment",
        "function": "verifyPayment"
      },
      {
        "source": "/api/fetchBankList",
        "function": "fetchBankList"
      },
      {
        "source": "/api/verifyBankAccount",
        "function": "verifyBankAccount"
      },
      {
        "source": "/api/paystackWebhook",
        "function": "paystackWebhook"
      }
    ]
  }
}
