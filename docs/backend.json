
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "type": "object",
      "description": "Represents a user's profile information.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity, same as Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "description": "The user's email address."
        },
        "businessId": {
          "type": "string",
          "description": "The ID of the business associated with the user."
        },
        "role": {
          "type": "string",
          "description": "The user's role in the system.",
          "enum": ["Owner", "Investor", "Admin", "Staff"]
        }
      },
      "required": ["id", "displayName", "email", "role"]
    },
    "Business": {
      "title": "Business",
      "type": "object",
      "description": "Represents a business in the system.",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who owns the business."
        },
        "businessName": {
          "type": "string",
          "description": "The name of the business."
        },
        "slug": {
            "type": "string",
            "description": "URL-friendly version of the business name for public store pages."
        },
        "businessType": {
          "type": "string",
          "description": "The type of business (e.g., shop, supermarket, food, service)."
        },
        "address": {
            "type": "string",
            "description": "The physical address of the business."
        },
        "currency": {
            "type": "string",
            "description": "The currency code for the business (e.g., NG, GH)."
        },
        "plan": {
            "type": "string",
            "description": "The selected subscription plan for the business."
        },
        "marketDescription": {
            "type": "string",
            "description": "Public-facing business description for the marketplace."
        },
        "marketSettings": {
          "type": "object",
          "description": "Settings for the business's public marketplace store.",
          "properties": {
            "isStoreActive": { "type": "boolean" },
            "bannerImageUrl": { "type": "string", "description": "URL for the store's banner image." },
            "logoImageUrl": { "type": "string", "description": "URL for the store's logo." },
            "contactPhone": { "type": "string", "description": "Public contact phone number." },
            "contactEmail": { "type": "string", "description": "Public contact email address." },
            "payment": {
              "type": "object",
              "properties": {
                "allowBankTransfer": { "type": "boolean" },
                "allowPayOnDelivery": { "type": "boolean" },
                "bankName": { "type": "string" },
                "accountNumber": { "type": "string" },
                "paymentInstructions": { "type": "string" }
              }
            },
            "delivery": {
              "type": "object",
              "properties": {
                "allowDelivery": { "type": "boolean" },
                "allowPickup": { "type": "boolean" },
                "deliveryFee": { "type": "number" },
                "deliveryDays": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        },
         "busmoPaySettings": {
          "type": "object",
          "description": "Settings for BusmoPay integration.",
          "properties": {
            "paystackEnabled": { "type": "boolean" },
            "paystackSecretKey": { "type": "string" },
            "airtelMoneyEnabled": { "type": "boolean" },
            "airtelMoneyClientSecret": { "type": "string" }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the business was created."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Indicates whether the onboarding process for the business is completed."
        }
      },
      "required": [
        "ownerId",
        "businessName",
        "slug",
        "businessType",
        "createdAt"
      ]
    },
    "BusinessProfile": {
      "title": "Business Profile",
      "type": "object",
      "description": "Public-facing business information for the marketplace.",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who owns the business."
        },
        "businessName": { "type": "string" },
        "slug": { "type": "string", "description": "URL-friendly version of the business name for public store pages." },
        "businessType": { "type": "string" },
        "address": { "type": "string" },
        "marketDescription": { "type": "string" },
        "currency": { "type": "string" },
        "marketSettings": {
          "type": "object",
          "description": "Settings for the business's public marketplace store.",
          "properties": {
            "isStoreActive": { "type": "boolean" },
            "bannerImageUrl": { "type": "string", "description": "URL for the store's banner image." },
            "logoImageUrl": { "type": "string", "description": "URL for the store's logo." },
            "contactPhone": { "type": "string", "description": "Public contact phone number." },
            "contactEmail": { "type": "string", "description": "Public contact email address." }
          }
        }
      },
      "required": ["ownerId", "businessName", "slug", "businessType"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Represents a product offered by a business.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the product."
        },
        "price": {
          "type": "number",
          "description": "The selling price of the product (used if no variants)."
        },
        "oldPrice": {
          "type": "number",
          "description": "The previous price of the product, for displaying discounts."
        },
        "cost": {
          "type": "number",
          "description": "The cost price of the product (used if no variants)."
        },
        "quantity": {
          "type": "number",
          "description": "The current stock quantity of the product (used if no variants)."
        },
        "isPublishedToMarket": {
          "type": "boolean",
          "description": "Indicates if the product is visible on the public marketplace."
        },
        "description": {
          "type": "string",
          "description": "Public-facing product description for the marketplace."
        },
        "category": {
          "type": "string",
          "description": "Public-facing product category for the marketplace."
        },
        "images": {
            "type": "array",
            "description": "URLs or data URIs of the product images.",
            "items": { "type": "string" }
        },
        "hint": {
            "type": "string",
            "description": "A hint for AI image generation services."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the product was created."
        },
        "hasVariants": {
          "type": "boolean",
          "description": "Indicates if the product has multiple variants."
        },
        "variants": {
          "type": "array",
          "description": "List of product variants, each with its own price, cost, and quantity.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "description": "Unique ID for the variant within the product." },
              "name": { "type": "string", "description": "Name of the variant (e.g., 'Red', 'Large')." },
              "price": { "type": "number" },
              "cost": { "type": "number" },
              "quantity": { "type": "number" },
              "image": { "type": "string", "description": "URL or data URI of the variant's image." }
            },
            "required": ["id", "name", "price", "quantity"]
          }
        },
        "busmoPayEnabled": {
            "type": "boolean",
            "description": "Indicates if BusmoPay payment rails are enabled for this product."
        }
      },
      "required": [
        "name",
        "isPublishedToMarket",
        "createdAt"
      ]
    },
    "PointOfSale": {
      "title": "Point of Sale",
      "type": "object",
      "description": "Represents a single POS sales transaction (not online).",
      "properties": {
        "businessId": { "type": "string", "description": "The ID of the business that made the sale." },
        "productId": { "type": "string", "description": "The ID of the product sold." },
        "productName": { "type": "string", "description": "The name of the product sold (denormalized)." },
        "variantId": { "type": "string", "description": "The ID of the product variant sold, if applicable." },
        "variantName": { "type": "string", "description": "The name of the product variant sold (denormalized)." },
        "amount": { "type": "number", "description": "The total amount of the sale." },
        "quantity": { "type": "number", "description": "The quantity of the product sold." },
        "paymentType": { "type": "string", "description": "The payment method used (e.g., cash, pos, transfer)." },
        "source": { "type": "string", "description": "The source of the sale (e.g., pos, market)." },
        "timestamp": { "type": "string", "format": "date-time", "description": "Timestamp indicating when the sale occurred." }
      },
      "required": ["businessId", "productId", "amount", "quantity", "paymentType", "source", "timestamp"]
    },
    "MarketProduct": {
      "title": "MarketProduct",
      "type": "object",
      "description": "A denormalized, public-facing product for the marketplace.",
      "properties": {
        "productId": { "type": "string", "description": "The original product ID." },
        "businessId": { "type": "string", "description": "The ID of the business selling the product." },
        "businessName": { "type": "string", "description": "The name of the business selling the product (denormalized)." },
        "productName": { "type": "string", "description": "The name of the product." },
        "price": { "type": "number", "description": "The base or default price of the product." },
        "oldPrice": { "type": "number", "description": "The previous price of the product, for displaying discounts." },
        "description": { "type": "string", "description": "Public-facing product description." },
        "category": { "type": "string", "description": "The product category." },
        "images": { "type": "array", "description": "URL or data URI for the product's images.", "items": { "type": "string" } },
        "hint": { "type": "string", "description": "A hint for AI image services." },
        "availableQuantity": { "type": "number", "description": "The total available stock of the product across all variants." },
        "status": { "type": "string", "enum": ["active", "draft"], "description": "The visibility status of the product on the marketplace." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp from the original product creation." },
        "hasVariants": { "type": "boolean", "description": "Indicates if the product has multiple variants." },
        "variants": { "type": "array", "description": "List of available product variants for the market.", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "price": { "type": "number" }, "availableQuantity": { "type": "number" }, "image": { "type": "string" } }, "required": ["id", "name", "price", "availableQuantity"] } }
      },
      "required": ["productId", "businessId", "businessName", "productName", "price", "category", "availableQuantity", "status", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "description": "Represents a customer order from the public marketplace. Legacy, being replaced by PaymentIntent.",
      "properties": {
        "buyerId": { "type": "string" }, "sellerBusinessId": { "type": "string" },
        "customer": { "type": "object", "properties": { "name": { "type": "string" }, "phone": { "type": "string" }, "address": { "type": "string" } }, "required": ["name", "phone"] },
        "items": { "type": "array", "items": { "type": "object", "properties": { "productId": { "type": "string" }, "productName": { "type": "string" }, "variantId": { "type": "string" }, "variantName": { "type": "string" }, "quantity": { "type": "number" }, "price": { "type": "number" } } } },
        "subtotal": { "type": "number" }, "deliveryFee": { "type": "number" }, "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "shipped", "fulfilled", "cancelled"] },
        "fulfillment": { "type": "string", "enum": ["delivery", "pickup"] }, "payment": { "type": "string", "enum": ["transfer", "delivery"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerId", "sellerBusinessId", "customer", "items", "total", "status", "fulfillment", "payment", "createdAt"]
    },
    "Expense": {
      "title": "Expense",
      "type": "object",
      "description": "Represents a single business expense.",
      "properties": {
        "businessId": { "type": "string" }, "category": { "type": "string" }, "title": { "type": "string" }, "amount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "category", "title", "amount", "createdAt"]
    },
    "CashTransaction": {
      "title": "Cash Transaction",
      "type": "object",
      "description": "Represents a cash deposit or withdrawal.",
      "properties": {
        "businessId": { "type": "string" }, "type": { "type": "string", "enum": ["deposit", "withdrawal"] }, "amount": { "type": "number" },
        "description": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "type", "amount", "createdAt"]
    },
    "BlogPost": { "title": "Blog Post", "type": "object", "description": "Represents a single blog post article.", "properties": { "title": { "type": "string" }, "slug": { "type": "string" }, "description": { "type": "string" }, "content": { "type": "string" }, "author": { "type": "string" }, "imageUrl": { "type": "string" }, "imageHint": { "type": "string" }, "isPublished": { "type": "boolean" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } }, "required": ["title", "slug", "content", "author", "createdAt"] },
    "SupportTicket": { "title": "Support Ticket", "type": "object", "description": "Represents a customer support request.", "properties": { "userId": { "type": "string" }, "userName": { "type": "string" }, "userEmail": { "type": "string" }, "subject": { "type": "string" }, "message": { "type": "string" }, "status": { "type": "string", "enum": ["open", "in-progress", "closed"] }, "createdAt": { "type": "string", "format": "date-time" } }, "required": ["userId", "subject", "message", "status", "createdAt"] },
    "StaffInvitation": { "title": "Staff Invitation", "type": "object", "description": "Represents an invitation for a user to become a staff member of a business.", "properties": { "email": { "type": "string" }, "businessId": { "type": "string" }, "businessName": { "type": "string" }, "status": { "type": "string", "enum": ["pending", "accepted"] }, "createdAt": { "type": "string", "format": "date-time" } }, "required": ["email", "businessId", "status", "createdAt"] },
    "PaymentIntent": {
      "title": "Payment Intent", "type": "object", "description": "Represents a request to create a payment.",
      "properties": {
        "merchantId": { "type": "string" }, "customerId": { "type": "string" }, "amount": { "type": "number" }, "currency": { "type": "string" },
        "method": { "type": "string", "enum": ["paystack", "airtel_money"] }, "status": { "type": "string", "enum": ["pending", "succeeded", "failed"] },
        "items": { "type": "array", "items": { "type": "object", "properties": { "productId": { "type": "string" }, "name": { "type": "string" }, "quantity": { "type": "number" }, "price": { "type": "number" } } } },
        "providerIntentId": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["merchantId", "amount", "currency", "method", "status", "createdAt"]
    },
    "FinancialTransaction": {
      "title": "Financial Transaction", "type": "object", "description": "Represents a completed financial transaction and profit share.",
      "properties": {
        "paymentIntentId": { "type": "string" }, "merchantId": { "type": "string" }, "customerId": { "type": "string" }, "amount": { "type": "number" }, "currency": { "type": "string" },
        "method": { "type": "string" }, "status": { "type": "string" }, "platformFee": { "type": "number" }, "investorProfitShare": { "type": "number" }, "merchantPayout": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["paymentIntentId", "merchantId", "amount", "status", "completedAt"]
    },
    "WebhookLog": { "title": "Webhook Log", "type": "object", "description": "Logs incoming webhooks from payment providers.", "properties": { "provider": { "type": "string" }, "payload": { "type": "object" }, "isProcessed": { "type": "boolean" }, "createdAt": { "type": "string", "format": "date-time" } }, "required": ["provider", "payload", "createdAt"] }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      { "path": "users/{userId}", "definition": { "entityName": "UserProfile", "schema": { "$ref": "#/backend/entities/UserProfile" }, "description": "Stores user profile information." } },
      { "path": "businesses/{businessId}", "definition": { "entityName": "Business", "schema": { "$ref": "#/backend/entities/Business" }, "description": "Top-level collection for all business data." } },
      { "path": "businessProfiles/{businessId}", "definition": { "entityName": "BusinessProfile", "schema": { "$ref": "#/backend/entities/BusinessProfile" }, "description": "Publicly readable information about a business for the marketplace." } },
      { "path": "businesses/{businessId}/products/{productId}", "definition": { "entityName": "Product", "schema": { "$ref": "#/backend/entities/Product" }, "description": "Subcollection for products belonging to a business." } },
      { "path": "businesses/{businessId}/sales/{saleId}", "definition": { "entityName": "PointOfSale", "schema": { "$ref": "#/backend/entities/PointOfSale" }, "description": "Subcollection for POS sales transactions belonging to a business." } },
      { "path": "businesses/{businessId}/orders/{orderId}", "definition": { "entityName": "Order", "schema": { "$ref": "#/backend/entities/Order" }, "description": "Subcollection for market orders (legacy)." } },
      { "path": "marketProducts/{marketProductId}", "definition": { "entityName": "MarketProduct", "schema": { "$ref": "#/backend/entities/MarketProduct" }, "description": "Publicly readable collection of products listed on the marketplace." } },
      { "path": "businesses/{businessId}/expenses/{expenseId}", "definition": { "entityName": "Expense", "schema": { "$ref": "#/backend/entities/Expense" }, "description": "Subcollection for expenses belonging to a business." } },
      { "path": "businesses/{businessId}/cashTransactions/{transactionId}", "definition": { "entityName": "CashTransaction", "schema": { "$ref": "#/backend/entities/CashTransaction" }, "description": "Subcollection for cash deposits and withdrawals." } },
      { "path": "blogs/{blogId}", "definition": { "entityName": "BlogPost", "schema": { "$ref": "#/backend/entities/BlogPost" }, "description": "Collection for all blog posts." } },
      { "path": "supportTickets/{ticketId}", "definition": { "entityName": "SupportTicket", "schema": { "$ref": "#/backend/entities/SupportTicket" }, "description": "Collection for all customer support tickets." } },
      { "path": "invitations/{invitationId}", "definition": { "entityName": "StaffInvitation", "schema": { "$ref": "#/backend/entities/StaffInvitation" }, "description": "Stores pending invitations for staff members." } },
      { "path": "paymentIntents/{intentId}", "definition": { "entityName": "PaymentIntent", "schema": { "$ref": "#/backend/entities/PaymentIntent" }, "description": "Collection for all BusmoPay payment intents." } },
      { "path": "businesses/{businessId}/financialTransactions/{transactionId}", "definition": { "entityName": "FinancialTransaction", "schema": { "$ref": "#/backend/entities/FinancialTransaction" }, "description": "Subcollection for completed financial transactions and profit sharing." } },
      { "path": "webhookLogs/{logId}", "definition": { "entityName": "WebhookLog", "schema": { "$ref": "#/backend/entities/WebhookLog" }, "description": "Logs all incoming webhooks from payment providers." } }
    ]
  }
}

