{
  "entities": {
    "Business": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Business",
      "type": "object",
      "description": "Represents a business using the BizAssistant app.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the business entity."
        },
        "ownerId": {
          "type": "string",
          "description": "The UID of the business owner."
        },
        "name": {
          "type": "string",
          "description": "Name of the business."
        },
        "type": {
          "type": "string",
          "description": "Type of business (e.g., shop, supermarket, food, service, company)."
        },
        "currency": {
          "type": "string",
          "description": "Currency used by the business (e.g., ₦ / CFA)."
        },
        "plan": {
          "type": "string",
          "description": "The subscription plan for the business.",
          "enum": [
            "shop",
            "supermarket",
            "multi-branch",
            "company"
          ]
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "name"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the BizAssistant app. Can be a business owner or staff.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user entity (matches Firebase Auth UID)."
        },
        "displayName": {
          "type": "string",
          "description": "User's full name."
        },
        "email": {
          "type": "string",
          "description": "User's email address."
        },
        "businessId": {
          "type": "string",
          "description": "Reference to Business. Required for Owner/Staff roles."
        },
        "role": {
          "type": "string",
          "description": "User's role (e.g., Owner, Staff)."
        }
      },
      "required": [
        "id",
        "role"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/entities/User"
          },
          "description": "Stores user profiles. The `userId` parameter corresponds to the Firebase Auth UID."
        }
      },
      {
        "path": "/businesses/{businessId}",
        "definition": {
          "entityName": "Business",
          "schema": {
            "$ref": "#/entities/Business"
          },
          "description": "Stores business details. Contains `ownerId` for authorization."
        }
      }
    ]
  }
}
