
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "type": "object",
      "description": "Represents a user's profile information.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity, same as Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "description": "The user's email address."
        },
        "businessId": {
          "type": "string",
          "description": "The ID of the business owned by the user."
        },
        "role": {
          "type": "string",
          "description": "The user's role in the system.",
          "enum": ["Owner", "Investor", "Admin"]
        }
      },
      "required": ["id", "displayName", "email"]
    },
    "Business": {
      "title": "Business",
      "type": "object",
      "description": "Represents a business in the system.",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who owns the business."
        },
        "businessName": {
          "type": "string",
          "description": "The name of the business."
        },
        "businessType": {
          "type": "string",
          "description": "The type of business (e.g., shop, supermarket, food, service)."
        },
        "currency": {
            "type": "string",
            "description": "The currency code for the business (e.g., NG, GH)."
        },
        "plan": {
            "type": "string",
            "description": "The selected subscription plan for the business."
        },
        "marketDescription": {
            "type": "string",
            "description": "Public-facing business description for the marketplace."
        },
        "marketSettings": {
          "type": "object",
          "description": "Settings for the business's public marketplace store.",
          "properties": {
            "isStoreActive": { "type": "boolean" },
            "payment": {
              "type": "object",
              "properties": {
                "allowBankTransfer": { "type": "boolean" },
                "allowPayOnDelivery": { "type": "boolean" },
                "bankName": { "type": "string" },
                "accountNumber": { "type": "string" },
                "paymentInstructions": { "type": "string" }
              }
            },
            "delivery": {
              "type": "object",
              "properties": {
                "allowDelivery": { "type": "boolean" },
                "allowPickup": { "type": "boolean" },
                "deliveryFee": { "type": "number" },
                "deliveryDays": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the business was created."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Indicates whether the onboarding process for the business is completed."
        }
      },
      "required": [
        "ownerId",
        "businessName",
        "businessType",
        "createdAt",
        "onboardingCompleted"
      ]
    },
    "BusinessProfile": {
      "title": "Business Profile",
      "type": "object",
      "description": "Public-facing business information for the marketplace.",
      "properties": {
        "businessName": { "type": "string" },
        "marketDescription": { "type": "string" },
        "currency": { "type": "string" },
        "marketSettings": {
          "type": "object",
          "description": "Settings for the business's public marketplace store.",
          "properties": {
            "isStoreActive": { "type": "boolean" },
            "payment": {
              "type": "object",
              "properties": {
                "allowBankTransfer": { "type": "boolean" },
                "allowPayOnDelivery": { "type": "boolean" },
                "bankName": { "type": "string" },
                "accountNumber": { "type": "string" },
                "paymentInstructions": { "type": "string" }
              }
            },
            "delivery": {
              "type": "object",
              "properties": {
                "allowDelivery": { "type": "boolean" },
                "allowPickup": { "type": "boolean" },
                "deliveryFee": { "type": "number" },
                "deliveryDays": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "required": ["businessName"]
    },
    "Inventory": {
      "title": "Inventory",
      "type": "object",
      "description": "Represents a raw material or inventory item.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the inventory item."
        },
        "category": {
          "type": "string",
          "description": "The category of the inventory item."
        },
        "unit": {
          "type": "string",
          "description": "The unit of measure for the inventory item."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the inventory item was created."
        }
      },
      "required": ["name", "category", "unit", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Represents a product offered by a business.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the product."
        },
        "price": {
          "type": "number",
          "description": "The selling price of the product."
        },
        "cost": {
          "type": "number",
          "description": "The cost price of the product."
        },
        "quantity": {
          "type": "number",
          "description": "The current stock quantity of the product."
        },
        "isPublishedToMarket": {
          "type": "boolean",
          "description": "Indicates if the product is visible on the public marketplace."
        },
        "description": {
          "type": "string",
          "description": "Public-facing product description for the marketplace."
        },
        "category": {
          "type": "string",
          "description": "Public-facing product category for the marketplace."
        },
        "image": {
            "type": "string",
            "description": "URL or data URI of the primary product image."
        },
        "hint": {
            "type": "string",
            "description": "A hint for AI image generation services."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the product was created."
        }
      },
      "required": [
        "name",
        "price",
        "quantity",
        "isPublishedToMarket",
        "createdAt"
      ]
    },
    "Sale": {
      "title": "Sale",
      "type": "object",
      "description": "Represents a single sales transaction.",
      "properties": {
        "businessId": {
          "type": "string",
          "description": "The ID of the business that made the sale."
        },
        "productId": {
          "type": "string",
          "description": "The ID of the product sold."
        },
        "productName": {
          "type": "string",
          "description": "The name of the product sold (denormalized)."
        },
        "amount": {
          "type": "number",
          "description": "The total amount of the sale."
        },
        "quantity": {
          "type": "number",
          "description": "The quantity of the product sold."
        },
        "paymentType": {
          "type": "string",
          "description": "The payment method used (e.g., cash, pos, transfer)."
        },
        "source": {
          "type": "string",
          "description": "The source of the sale (e.g., pos, market)."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the sale occurred."
        }
      },
      "required": [
        "businessId",
        "productId",
        "amount",
        "quantity",
        "paymentType",
        "source",
        "timestamp"
      ]
    },
    "MarketProduct": {
      "title": "MarketProduct",
      "type": "object",
      "description": "A denormalized, public-facing product for the marketplace.",
      "properties": {
        "productId": {
          "type": "string",
          "description": "The original product ID."
        },
        "businessId": {
          "type": "string",
          "description": "The ID of the business selling the product."
        },
        "businessName": {
          "type": "string",
          "description": "The name of the business selling the product (denormalized)."
        },
        "productName": {
          "type": "string",
          "description": "The name of the product."
        },
        "price": {
          "type": "number",
          "description": "The price of the product."
        },
        "description": {
            "type": "string",
            "description": "Public-facing product description."
        },
        "category": {
          "type": "string",
          "description": "The product category."
        },
        "image": {
            "type": "string",
            "description": "URL or data URI for the product's primary image."
        },
        "hint": {
            "type": "string",
            "description": "A hint for AI image services."
        },
        "availableQuantity": {
            "type": "number",
            "description": "The current available stock of the product."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp from the original product creation."
        }
      },
      "required": [
        "productId",
        "businessId",
        "businessName",
        "productName",
        "price",
        "category",
        "availableQuantity",
        "createdAt"
      ]
    },
    "MarketOrder": {
      "title": "Market Order",
      "type": "object",
      "description": "Represents a customer order from the public marketplace.",
      "properties": {
        "businessId": { "type": "string" },
        "customer": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" },
            "address": { "type": "string" }
          },
          "required": ["name", "phone"]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "productName": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" }
            }
          }
        },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Shipped", "Delivered", "Cancelled"] },
        "fulfillment": { "type": "string", "enum": ["delivery", "pickup"] },
        "payment": { "type": "string", "enum": ["transfer", "delivery"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "customer", "items", "total", "status", "fulfillment", "payment", "createdAt"]
    },
    "Expense": {
      "title": "Expense",
      "type": "object",
      "description": "Represents a single business expense.",
      "properties": {
        "businessId": {
          "type": "string",
          "description": "The ID of the business that incurred the expense."
        },
        "category": {
          "type": "string",
          "description": "The category of the expense."
        },
        "title": {
          "type": "string",
          "description": "A short title for the expense."
        },
        "amount": {
          "type": "number",
          "description": "The amount of the expense."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the expense was recorded."
        }
      },
      "required": [
        "businessId",
        "category",
        "title",
        "amount",
        "createdAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "description": "Represents a cash deposit or withdrawal.",
      "properties": {
        "businessId": {
          "type": "string",
          "description": "The ID of the business."
        },
        "type": {
          "type": "string",
          "enum": ["deposit", "withdrawal"],
          "description": "The type of transaction."
        },
        "amount": {
          "type": "number",
          "description": "The transaction amount."
        },
        "description": {
          "type": "string",
          "description": "An optional note for the transaction."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the transaction was recorded."
        }
      },
      "required": [ "businessId", "type", "amount", "createdAt" ]
    },
    "BlogPost": {
      "title": "Blog Post",
      "type": "object",
      "description": "Represents a single blog post article.",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "imageUrl": { "type": "string" },
        "imageHint": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "content", "author", "createdAt"]
    },
    "SupportTicket": {
      "title": "Support Ticket",
      "type": "object",
      "description": "Represents a customer support request.",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in-progress", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subject", "message", "status", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores public-facing user profile information."
        }
      },
      {
        "path": "businesses/{businessId}",
        "definition": {
          "entityName": "Business",
          "schema": {
            "$ref": "#/backend/entities/Business"
          },
          "description": "Top-level collection for all business data. Each document is owned by a user."
        }
      },
      {
        "path": "businessProfiles/{businessId}",
        "definition": {
          "entityName": "BusinessProfile",
          "schema": {
            "$ref": "#/backend/entities/BusinessProfile"
          },
          "description": "Publicly readable information about a business for the marketplace."
        }
      },
      {
        "path": "businesses/{businessId}/inventory/{inventoryId}",
        "definition": {
          "entityName": "Inventory",
          "schema": {
            "$ref": "#/backend/entities/Inventory"
          },
          "description": "Subcollection for inventory items belonging to a business."
        }
      },
      {
        "path": "businesses/{businessId}/products/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": {
            "$ref": "#/backend/entities/Product"
          },
          "description": "Subcollection for products belonging to a business."
        }
      },
      {
        "path": "businesses/{businessId}/sales/{saleId}",
        "definition": {
          "entityName": "Sale",
          "schema": {
            "$ref": "#/backend/entities/Sale"
          },
          "description": "Subcollection for sales transactions belonging to a business."
        }
      },
      {
        "path": "businesses/{businessId}/orders/{orderId}",
        "definition": {
          "entityName": "MarketOrder",
          "schema": {
            "$ref": "#/backend/entities/MarketOrder"
          },
          "description": "Subcollection for orders made through the public marketplace."
        }
      },
      {
        "path": "marketProducts/{marketProductId}",
        "definition": {
          "entityName": "MarketProduct",
          "schema": {
            "$ref": "#/backend/entities/MarketProduct"
          },
          "description": "Publicly readable collection of products listed on the marketplace."
        }
      },
      {
        "path": "businesses/{businessId}/expenses/{expenseId}",
        "definition": {
          "entityName": "Expense",
          "schema": {
            "$ref": "#/backend/entities/Expense"
          },
          "description": "Subcollection for expenses belonging to a business."
        }
      },
      {
        "path": "businesses/{businessId}/transactions/{transactionId}",
        "definition": {
          "entityName": "Transaction",
          "schema": {
            "$ref": "#/backend/entities/Transaction"
          },
          "description": "Subcollection for cash deposits and withdrawals."
        }
      },
       {
        "path": "blogs/{blogId}",
        "definition": {
          "entityName": "BlogPost",
          "schema": {
            "$ref": "#/backend/entities/BlogPost"
          },
          "description": "Collection for all blog posts."
        }
      },
      {
        "path": "supportTickets/{ticketId}",
        "definition": {
          "entityName": "SupportTicket",
          "schema": {
            "$ref": "#/backend/entities/SupportTicket"
          },
          "description": "Collection for all customer support tickets."
        }
      }
    ]
  }
}
