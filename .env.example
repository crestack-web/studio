# ===================================
# BUSMO - Environment Variables
# ===================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ===================================
# Firebase Configuration
# ===================================
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin SDK (Required for server-side operations)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate Private Key
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ===================================
# AI Services
# ===================================
# Google AI (Genkit) - For business insights
GOOGLE_GENAI_API_KEY=your-google-ai-api-key

# Alibaba Cloud DashScope (Qwen) - For backend AI
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
QWEN_MODEL=qwen-max
QWEN_MAX_TOKENS=2000
QWEN_TEMPERATURE=0.7

# ===================================
# Payment Processing (Paystack)
# ===================================
# Test keys for development
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key

# Live keys for production (DO NOT USE IN DEVELOPMENT)
# PAYSTACK_SECRET_KEY=sk_live_xxx
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxx

# ===================================
# Payment Processing (Whop)
# ===================================
# Whop API key for subscription payments
WHOP_PAYEMENT_API=apik_your-whop-api-key

# ===================================
# Email Service (Brevo)
# ===================================
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_FROM_EMAIL=noreply@busmo.io
BREVO_FROM_NAME=Busmo

# ===================================
# Application URLs
# ===================================
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_BRAND_HOST=https://busmo.web.app

# For production, update to:
# PUBLIC_APP_URL=https://your-domain.com
# PUBLIC_BRAND_HOST=https://busmo.io

# ===================================
# Business Configuration
# ===================================
# Delay before staff can withdraw earnings (in hours)
PAYOUT_DELAY_HOURS=24

# Default currency
DEFAULT_CURRENCY=NGN

# ===================================
# WhatsApp Bot (Optional)
# ===================================
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# ===================================
# Chatwoot (Customer Support)
# ===================================
# Self-hosted Chatwoot instance at https://support.busmo.io
NEXT_PUBLIC_CHATWOOT_ENABLED=true
NEXT_PUBLIC_CHATWOOT_URL=https://support.busmo.io
NEXT_PUBLIC_CHATWOOT_ACCOUNT_ID=174477
NEXT_PUBLIC_CHATWOOT_INBOX_ID=1
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=your-website-token-here
CHATWOOT_API_ACCESS_TOKEN=ZV1bf3XmBzc15modj625j3ME
CHATWOOT_HMAC_SECRET=saRqHsXiAxDpGJfNsmBwkjWM

# ===================================
# Analytics (PostHog)
# ===================================
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ===================================
# Analytics (Optional)
# ===================================
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (Error Tracking)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
