# ===================================
# BUSMO - Environment Variables
# ===================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ===================================
# Supabase Configuration (migration target)
# ===================================
# Get these from Supabase Dashboard > Project Settings > API
# Project URL: https://<project-ref>.supabase.co
# anon key and service_role key under "Project API keys"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key - SERVER SIDE ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection (OPTIONAL — migration scripts use PostgREST + the
# service-role key and don't need this). Only for raw SQL / pg_dump.
# Get from Supabase Dashboard > Project Settings > Database > Connection string (URI)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ===================================
# Firebase Configuration (legacy, being deprecated)
# ===================================
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ===================================
# Email (Resend)
# ===================================
# Get API key from https://resend.com/api-keys
# Verify your domain (busmo.io) in Resend dashboard for production delivery
RESEND_API_KEY=re_xxxxxxxx
# Optional override for From address (default: Busmo <support@busmo.io>)
EMAIL_FROM=Busmo <support@busmo.io>
