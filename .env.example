# ===================================
# BUSMO - Environment Variables
# ===================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ===================================
# Supabase Configuration (migration target)
# ===================================
# Get these from Supabase Dashboard > Project Settings > API
# Project URL: https://<project-ref>.supabase.co
# anon key and service_role key under "Project API keys"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key - SERVER SIDE ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection (OPTIONAL — migration scripts use PostgREST + the
# service-role key and don't need this). Only for raw SQL / pg_dump.
# Get from Supabase Dashboard > Project Settings > Database > Connection string (URI)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ===================================
# Firebase Configuration (legacy, being deprecated)
# ===================================
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ===================================
# Email (Resend)
# ===================================
# Get API key from https://resend.com/api-keys
# Verify your domain (busmo.io) in Resend dashboard for production delivery
RESEND_API_KEY=re_xxxxxxxx
# Optional override for From address (default: Busmo <support@busmo.io>)
EMAIL_FROM=Busmo <support@busmo.io>

# Optional: HMAC secret for email confirmation links (falls back to SUPABASE_SERVICE_ROLE_KEY)
EMAIL_CONFIRM_SECRET=a-long-random-string
# App URL used in confirmation links (defaults to https://www.busmo.io)
NEXT_PUBLIC_APP_URL=https://www.busmo.io

# IMPORTANT — Email confirmation is sent via Resend, not Supabase Auth mail.
# In Supabase Dashboard → Authentication → Providers → Email:
#   - Keep "Confirm email" enabled if you want login blocked until confirmed
#   - Disable custom SMTP / Auth emails so only Resend delivers the link
# Confirmations call Admin API: auth.admin.updateUserById({ email_confirm: true })

# ===================================
# Infobip WhatsApp (MO Sales Agent V1) — SERVER ONLY
# ===================================
# From Infobip portal → Developer tools / API keys
INFOBIP_API_KEY=
# e.g. https://xxxxx.api.infobip.com  (no trailing slash)
INFOBIP_BASE_URL=
# Business WhatsApp sender in international format digits, e.g. 447860099299
INFOBIP_WHATSAPP_SENDER=
# Optional shared secret for webhook Authorization / x-webhook-secret header
# INFOBIP_WEBHOOK_SECRET=
# MO replies use existing MISTRAL_API_KEY
