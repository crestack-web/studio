# Copy to .env.local for local development
# Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase (if still used for some paths)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# App
NEXT_PUBLIC_APP_URL=https://busmo.app

# Optional: HMAC secret for email confirmation links (falls back to SUPABASE_SERVICE_ROLE_KEY)
# EMAIL_LINK_SECRET=

# MO Sales / WhatsApp (Infobip etc.)
# INFOBIP_API_KEY=
# INFOBIP_BASE_URL=
# INFOBIP_WEBHOOK_SECRET=
# MO replies use existing MISTRAL_API_KEY

# Mo-sell (child product) — Busmo admin activity + cross-project sync
# Same Supabase *account* as Busmo, different project (e.g. gcwjrukthcxvpwzhjuxz)
MO_SELL_SUPABASE_URL=https://YOUR_MO_SELL_PROJECT.supabase.co
MO_SELL_SUPABASE_SERVICE_ROLE_KEY=your-mo-sell-service-role-key
MO_SELL_APP_URL=https://mo-sell.store
