# Copy to .env.local for local development
# Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase (if still used for some paths)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# App origin — REQUIRED in Vercel for OAuth (Google) so redirects never hit localhost
# Use your real production domain (no trailing slash)
NEXT_PUBLIC_APP_URL=https://busmo.io
NEXT_PUBLIC_SITE_URL=https://busmo.io

# Optional: HMAC secret for email confirmation links (falls back to SUPABASE_SERVICE_ROLE_KEY)
# EMAIL_LINK_SECRET=

# MO Sales / WhatsApp (Infobip etc.)
# INFOBIP_API_KEY=
# INFOBIP_BASE_URL=
# INFOBIP_WEBHOOK_SECRET=
# MO replies use existing MISTRAL_API_KEY

# Mo-sell (child product) — Busmo admin activity + cross-project sync
# Same Supabase *account* as Busmo, different project (e.g. gcwjrukthcxvpwzhjuxz)
MO_SELL_SUPABASE_URL=https://YOUR_MO_SELL_PROJECT.supabase.co
MO_SELL_SUPABASE_SERVICE_ROLE_KEY=your-mo-sell-service-role-key
MO_SELL_APP_URL=https://mo-sell.store

# ---------------------------------------------------------------------------
# Google OAuth (Supabase) — if sign-in falls back to localhost, check ALL of:
#
# 1) Vercel → Project → Settings → Environment Variables (Production):
#    NEXT_PUBLIC_APP_URL=https://YOUR_PRODUCTION_DOMAIN
#    NEXT_PUBLIC_SITE_URL=https://YOUR_PRODUCTION_DOMAIN
#    Then Redeploy (env is baked into the client bundle).
#
# 2) Supabase → Authentication → URL Configuration:
#    Site URL = https://YOUR_PRODUCTION_DOMAIN  (NOT http://localhost:3000)
#    Redirect URLs must include:
#      https://YOUR_PRODUCTION_DOMAIN/auth/callback
#      https://YOUR_PRODUCTION_DOMAIN/**
#      http://localhost:3000/auth/callback   (dev only)
#
# 3) Supabase → Authentication → Providers → Google: enabled, Client ID + Secret set
#
# 4) Google Cloud Console → OAuth 2.0 Client → Authorized redirect URIs:
#    https://YOUR_PROJECT.supabase.co/auth/v1/callback
#    (this is the Supabase callback, not your app domain)
# ---------------------------------------------------------------------------
