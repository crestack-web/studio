# ===================================
# BUSMO Cloud Functions - Environment Variables
# ===================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===================================
# Firebase Configuration
# ===================================
FIREBASE_PROJECT_ID=your-project-id

# ===================================
# AI Services
# ===================================
# Alibaba Cloud DashScope (Qwen3.5)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
QWEN_MODEL=qwen-max
QWEN_MAX_TOKENS=2000
QWEN_TEMPERATURE=0.7

# Google AI (for Genkit flows)
GOOGLE_GENAI_API_KEY=your-google-ai-api-key

# ===================================
# Payment Processing (Paystack)
# ===================================
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key

# Payout Configuration
PAYOUT_DELAY_HOURS=24

# ===================================
# Email Service (SendGrid)
# ===================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@busmo.io
SENDGRID_FROM_NAME=Busmo

# SMTP Fallback (optional, SendGrid SMTP)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=your-sendgrid-api-key

# ===================================
# Application URLs
# ===================================
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_BRAND_HOST=https://busmo.web.app

# For production:
# PUBLIC_APP_URL=https://your-domain.com
# PUBLIC_BRAND_HOST=https://busmo.io

# ===================================
# WhatsApp Bot Configuration (Optional)
# ===================================
WHATSAPP_VERIFY_TOKEN=busmo_secret_2026
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ===================================
# Admin Configuration
# ===================================
ADMIN_EMAIL=admin@busmo.io
SUPPORT_EMAIL=support@busmo.io

# ===================================
# Logging & Monitoring
# ===================================
LOG_LEVEL=info
# Options: debug, info, warn, error
