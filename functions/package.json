{
  "name": "mo-app-functions",
  "version": "1.0.0",
  "description": "MO App Backend - AI-powered fintech for African SMBs",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
