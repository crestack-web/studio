# ═══════════════════════════════════════════
#  MO App Integration Testing - Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env.test and fill in your values
# DO NOT commit .env.test to version control!

# ═══════════════════════════════════════════
#  Firebase Cloud Functions (Direct URLs)
#  Format: https://<region>-<project-id>.cloudfunctions.net/<functionName>
# ═══════════════════════════════════════════
# ═══════════════════════════════════════════
#  Alibaba Cloud API Gateway URLs
#  Format: https://<api-group-id>.apigateway.<region>.aliyuncs.com/<path>
# ═══════════════════════════════════════════
# ═══════════════════════════════════════════
#  Alibaba Cloud Authentication
#  Get these from Alibaba Cloud API Gateway Console
# ═══════════════════════════════════════════
# ═══════════════════════════════════════════
#  Test Data
#  Merchant and User IDs for testing
# ═══════════════════════════════════════════
# ═══════════════════════════════════════════
#  Supabase (migration target)
# ═══════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ═══════════════════════════════════════════
#  Optional: Firebase Admin SDK (for DB validation)
# ═══════════════════════════════════════════
# FIREBASE_PROJECT_ID=bizassistant2-62305643-adad7
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@bizassistant2-62305643-adad7.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key

# ═══════════════════════════════════════════
#  Google Generative AI (removed - now using Mistral)
# ═══════════════════════════════════════════
# GOOGLE_GENAI_API_KEY=your-google-ai-api-key
# ═══════════════════════════════════════════

# ═══════════════════════════════════════════
#  Alibaba Cloud API Configuration
# ═══════════════════════════════════════════
# ═══════════════════════════════════════════
#  Test Data
#  Merchant and User IDs for testing
# ═══════════════════════════════════════════

TEST_MERCHANT_ID=demo
TEST_USER_ID=test-user-123