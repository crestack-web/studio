# ═══════════════════════════════════════════
#  MO App Integration Testing - Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env.test and fill in your values
# DO NOT commit .env.test to version control!

# ═══════════════════════════════════════════
#  Firebase Cloud Functions (Direct URLs)
#  Format: https://<region>-<project-id>.cloudfunctions.net/<functionName>
# ═══════════════════════════════════════════

FIREBASE_FUNCTION_URL_RECORD_SALE=https://us-central1-bizassistant2-62305643-adad7.cloudfunctions.net/recordSale
FIREBASE_FUNCTION_URL_ADD_PRODUCT=https://us-central1-bizassistant2-62305643-adad7.cloudfunctions.net/addProduct
FIREBASE_FUNCTION_URL_ASK_BUSINESS=https://us-central1-bizassistant2-62305643-adad7.cloudfunctions.net/askBusiness

# ═══════════════════════════════════════════
#  Alibaba Cloud API Gateway URLs
#  Format: https://<api-group-id>.apigateway.<region>.aliyuncs.com/<path>
# ═══════════════════════════════════════════

GATEWAY_URL_RECORD_SALE=https://your-api-group-id.apigateway.us-central1.aliyuncs.com/ai/record-sale
GATEWAY_URL_ADD_PRODUCT=https://your-api-group-id.apigateway.us-central1.aliyuncs.com/ai/add-product
GATEWAY_URL_ASK_BUSINESS=https://your-api-group-id.apigateway.us-central1.aliyuncs.com/ai/ask-business

# ═══════════════════════════════════════════
#  Alibaba Cloud Authentication
#  Get these from Alibaba Cloud API Gateway Console
# ═══════════════════════════════════════════

ALIBABA_APP_KEY=your-app-key-here
ALIBABA_APP_SECRET=your-app-secret-here

# ═══════════════════════════════════════════
#  Test Data
#  Merchant and User IDs for testing
# ═══════════════════════════════════════════

TEST_MERCHANT_ID=demo
TEST_USER_ID=test-user-123

# ═══════════════════════════════════════════
#  Optional: Firebase Admin SDK (for DB validation)
# ═══════════════════════════════════════════

# FIREBASE_PROJECT_ID=bizassistant2-62305643-adad7
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@bizassistant2-62305643-adad7.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
