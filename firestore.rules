
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Safely checks if the currently authenticated user has the 'Admin' role.
      // Checks for auth, document existence, and role property before returning.
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isSignedIn() && userDoc != null && 'role' in userDoc.data && userDoc.data.role == 'Admin';
    }
    
    function isBusinessOwner(businessId) {
      // Safely checks if the currently authenticated user is the owner of the specified business.
      // Checks for auth, document existence, and ownerId property.
      let businessDoc = get(/databases/$(database)/documents/businesses/$(businessId));
      return isSignedIn() && businessDoc != null && 'ownerId' in businessDoc.data && businessDoc.data.ownerId == request.auth.uid;
    }


    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId;
      // User can update their own profile, but cannot change their businessId once set.
      allow update: if (request.auth.uid == userId && (request.resource.data.businessId == resource.data.businessId || resource.data.businessId == null)) || isAdmin();
      allow delete: if request.auth.uid == userId || isAdmin();
    }

    match /businesses/{businessId} {
      // Only the business owner or an admin can GET the private business document.
      allow get: if isBusinessOwner(businessId) || isAdmin();
      // Only an admin can LIST all businesses to prevent unsafe queries.
      allow list: if isAdmin();
      // Write is safe as it targets a specific document.
      allow write: if isBusinessOwner(businessId) || isAdmin();
    }
    
    match /businessProfiles/{businessId} {
      // This collection is for public marketplace data. ANYONE can read it.
      allow get, list: if true;
      
      // Only the business owner or an admin can write to the public profile.
      allow write: if isBusinessOwner(businessId) || isAdmin();
    }

    // Generic rules for most business-owned subcollections.
    // This is safe because businessId is always a specific document ID here, not a wildcard.
    match /businesses/{businessId}/{subcollection}/{docId} 
        where subcollection in ['inventory', 'products', 'sales', 'expenses', 'transactions'] {
      allow get, list: if isBusinessOwner(businessId) || isAdmin();
      allow write: if isBusinessOwner(businessId) || isAdmin();
    }

    // Special rules for the 'orders' subcollection.
    match /businesses/{businessId}/orders/{orderId} {
      // Allow authenticated users to create orders for themselves.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Allow the customer, business owner, or an admin to get a single order.
      allow get: if isBusinessOwner(businessId) || isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Only the business owner or admin can list all orders.
      allow list: if isBusinessOwner(businessId) || isAdmin();
      // Business owner can update/delete order. Customer can too (e.g. cancel). Admin cannot.
      allow update, delete: if isBusinessOwner(businessId) || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /marketProducts/{marketProductId} {
      // Publicly readable for the market.
      allow get, list: if true;
      
      // Allow creation/update if the user is the owner of the business they are listing for.
      allow create, update: if isBusinessOwner(request.resource.data.businessId) || isAdmin();
      
      // Allow deletion if the user owns the business the product belongs to.
      allow delete: if isBusinessOwner(resource.data.businessId) || isAdmin();
    }
    
    match /blogs/{blogId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /supportTickets/{ticketId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
