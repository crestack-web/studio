
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Checks if a user is associated with a business via their user profile.
    function isMemberOfBusiness(businessId) {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == businessId;
    }

    // Checks if the user is the actual owner of the business document.
    // This relies on isMemberOfBusiness to ensure the initial 'get' is allowed.
    function isBusinessOwner(businessId) {
      return isMemberOfBusiness(businessId) && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
      allow get, delete: if isOwner(userId) || isAdmin();
      
      // Users can update their own profile, but cannot change an existing businessId.
      // This prevents a user from hijacking another business's read access.
      allow update: if (isOwner(userId) && 
                      (request.resource.data.businessId == resource.data.businessId || resource.data.businessId == null)
                    ) || isAdmin();
      allow list: if isAdmin();
    }

    // Rules for the 'businesses' collection
    match /businesses/{businessId} {
      // Read access is granted if the user's profile links to this business.
      allow get: if isMemberOfBusiness(businessId) || isAdmin();
      
      // Write access is ONLY granted if the `ownerId` on the business document itself matches the user.
      allow create: if isOwner(request.resource.data.ownerId);
      allow update, delete: if isBusinessOwner(businessId) || isAdmin();

      allow list: if isAdmin();
    }
    
    // Rules for the 'businessProfiles' collection (Public-facing data)
    match /businessProfiles/{businessId} {
      allow get: if true;
      allow write: if isBusinessOwner(businessId) || isAdmin();
    }

    // Rules for the 'inventory' subcollection
    match /businesses/{businessId}/inventory/{inventoryId} {
      allow read: if isMemberOfBusiness(businessId) || isAdmin();
      allow write: if isBusinessOwner(businessId) || isAdmin();
    }

    // Rules for the 'products' subcollection
    match /businesses/{businessId}/products/{productId} {
      allow read: if isMemberOfBusiness(businessId) || isAdmin();
      allow write: if isBusinessOwner(businessId) || isAdmin();
    }

    // Rules for the 'sales' subcollection
    match /businesses/{businessId}/sales/{saleId} {
      allow read: if isMemberOfBusiness(businessId) || isAdmin();
      allow write: if isBusinessOwner(businessId) || isAdmin();
    }
    
    // Rules for the 'orders' subcollection
    match /businesses/{businessId}/orders/{orderId} {
      allow read: if isMemberOfBusiness(businessId) || isAdmin();
      allow create: if true; // Allow anyone to create an order (e.g., public checkout)
      allow update, delete: if isBusinessOwner(businessId) || isAdmin();
    }

    // Rules for the 'expenses' subcollection
    match /businesses/{businessId}/expenses/{expenseId} {
      allow read: if isMemberOfBusiness(businessId) || isAdmin();
      allow write: if isBusinessOwner(businessId) || isAdmin();
    }

    // Rules for the 'transactions' subcollection
    match /businesses/{businessId}/transactions/{transactionId} {
      allow read: if isMemberOfBusiness(businessId) || isAdmin();
      allow write: if isBusinessOwner(businessId) || isAdmin();
    }

    // Rules for the 'marketProducts' collection
    match /marketProducts/{marketProductId} {
      allow get, list: if true;

      // --- Helper Functions for Market Products ---
      function isSourceProductPublished(businessId, productId) {
        let productPath = /databases/$(database)/documents/businesses/$(businessId)/products/$(productId);
        return exists(productPath) && get(productPath).data.isPublishedToMarket == true;
      }

      function isMarketDataConsistent(incomingData, productId) {
        let productPath = /databases/$(database)/documents/businesses/$(incomingData.businessId)/products/$(productId);
        let product = get(productPath).data;
        let businessPath = /databases/$(database)/documents/businesses/$(incomingData.businessId);
        let business = get(businessPath).data;
        
        return incomingData.productId == productId &&
               incomingData.businessName == business.businessName &&
               incomingData.productName == product.name &&
               incomingData.price == product.price &&
               incomingData.category == product.category &&
               incomingData.description == product.description &&
               incomingData.availableQuantity == product.quantity;
      }
      
      // Allow creation only by the business owner, and only if the source product is published and data is consistent.
      allow create: if (isBusinessOwner(request.resource.data.businessId) &&
                       isSourceProductPublished(request.resource.data.businessId, request.resource.data.productId) &&
                       isMarketDataConsistent(request.resource.data, request.resource.data.productId)) || isAdmin();

      // Allow updates only from the business owner, ensuring data remains consistent.
      allow update: if (isBusinessOwner(resource.data.businessId) &&
                       isSourceProductPublished(request.resource.data.businessId, request.resource.data.productId) &&
                       isMarketDataConsistent(request.resource.data, request.resource.data.productId)) || isAdmin();
      
      // Allow deletion only by the business owner.
      allow delete: if isBusinessOwner(resource.data.businessId) || isAdmin();
    }
    
    // Rules for the 'blogs' collection
    match /blogs/{blogId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Rules for the 'supportTickets' collection
    match /supportTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read, list, update, delete: if isAdmin();
    }
  }
}
