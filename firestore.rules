rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated.
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the user's auth UID matches the document's path ID.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Users can create, read, and update their own profile. They cannot delete it or see others' profiles.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get, update: if isOwner(userId);
      // Deny create/delete/list for security. Create happens server-side with account.
      allow create, delete, list: if false;
    }

    /**
     * @description
     * A user can create a business if they set themselves as the owner.
     * Only the owner of a business can get, update, or delete it.
     * Listing all businesses is denied for security.
     * @path /businesses/{businessId}
     */
    match /businesses/{businessId} {
      allow create: if request.resource.data.ownerId == request.auth.uid;
      allow get, update, delete: if resource.data.ownerId == request.auth.uid;
      allow list: if false;
    }
  }
}
