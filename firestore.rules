
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Get the full user document for the requesting user.
    function getRequestingUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // This is the NEW, NON-RECURSIVE way to check for admin status.
    // It relies on a document existing in the /admins collection.
    // MODIFIED: Also includes the Super Admin check.
    function isRequestingUserAdmin() {
      return isSignedIn() && (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || isSuperAdmin());
    }
    
    // This function is for bootstrapping the first admin or for emergency recovery.
    function isSuperAdmin() {
      return request.auth.token.email == 'crestack@gmail.com';
    }
    
    // Check if the requesting user is the owner of a specific business.
    function isOwner(businessId) {
      if (!isSignedIn()) { return false; }
      let businessDocPath = /databases/$(database)/documents/businesses/$(businessId);
      if (!exists(businessDocPath)) {
          return false;
      }
      // Directly check the ownerId on the business document for robustness.
      let businessDoc = get(businessDocPath);
      return businessDoc.data.ownerId == request.auth.uid;
    }

    // Check if the requesting user is a member of a specific business.
    function isBusinessMember(businessId) {
      if (!isSignedIn()) { return false; }
      // An owner is always a business member, even if their user document is out of sync.
      if (get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid) { return true; }
      // For other members (e.g., staff), we check their user document.
      let userData = getRequestingUserData();
      return userData != null && userData.businessId == businessId;
    }

    // --- COLLECTIONS ---
    match /users/{userId} {
      // Any signed-in user can create their own user document.
      allow create: if isUser(userId);
      // A user can read their own document. An admin can read any user document.
      allow get: if isUser(userId) || isRequestingUserAdmin();
      // Admins can list users.
      allow list: if isRequestingUserAdmin();
      // An admin can update any user. A user can only update their own profile, and cannot change their role or businessId.
      allow update: if (isUser(userId) && !('role' in request.resource.data) && !('businessId' in request.resource.data)) || isRequestingUserAdmin();
      allow delete: if isRequestingUserAdmin();
      
      // Subscriptions can only be read by the user, and written by a secure backend process (simulated).
      match /subscriptions/{subscriptionId} {
        allow read: if isUser(userId);
        allow write: if false; 
      }
    }
    
    // The 'admins' collection is used for the non-recursive admin check.
    // Only another admin or the super admin can create/delete admin records.
    match /admins/{userId} {
      allow read: if true;
      allow write: if isRequestingUserAdmin() || isSuperAdmin();
    }

    match /admin_permissions/{userId} {
      // Only Admins can read or write other admin permissions.
      allow read, write: if isRequestingUserAdmin();
    }
    
    match /subscriptionTransactions/{transactionId} {
      // A user can read their own transactions, or an admin can read any.
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isRequestingUserAdmin();
      allow write: if false; // Only backend can write
    }
    
    match /coupons/{couponId} {
      allow get: if isSignedIn();
      allow list, write: if isRequestingUserAdmin();
    }

    match /businesses/{businessId} {
      allow get: if isBusinessMember(businessId) || isRequestingUserAdmin();
      allow create: if isOwner(businessId);
      allow update: if isOwner(businessId) || isRequestingUserAdmin();
      allow list, delete: if false;

      // Business Subcollections
      match /products/{docId} { allow read, write: if isBusinessMember(businessId) || isRequestingUserAdmin(); }
      match /sales/{docId} { allow read, write: if isBusinessMember(businessId) || isRequestingUserAdmin(); }
      match /expenses/{docId} { allow read, write: if isBusinessMember(businessId) || isRequestingUserAdmin(); }
      match /transactions/{docId} { allow read, write: if isBusinessMember(businessId) || isRequestingUserAdmin(); }
      match /invitations/{invitationId} { allow read, write: if isOwner(businessId) || isRequestingUserAdmin(); }
      match /orders/{orderId} {
        allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
        allow get: if (isSignedIn() && resource.data.buyerId == request.auth.uid) || isBusinessMember(businessId) || isRequestingUserAdmin();
        allow update, list: if isBusinessMember(businessId) || isRequestingUserAdmin();
        allow delete: if isRequestingUserAdmin();
      }
      match /bankAccount/{accountId} { allow read, write: if isOwner(businessId) || isRequestingUserAdmin(); }
      match /paymentTransactions/{transactionId} {
          allow read: if isOwner(businessId) || isRequestingUserAdmin();
          allow write: if false;
      }
      match /payouts/{payoutId} {
          allow read: if isOwner(businessId) || isRequestingUserAdmin();
          allow write: if false;
      }
    }
    
    // --- MARKETPLACE & OTHER COLLECTIONS ---
    match /businessProfiles/{businessId} {
      allow get, list: if true;
      allow create, update, delete: if isOwner(businessId) || isRequestingUserAdmin();
    }
    
    match /marketProducts/{productId} {
      allow get, list: if true;
      allow create: if isOwner(request.resource.data.businessId);
      allow update: if isOwner(resource.data.businessId) || isRequestingUserAdmin();
      allow delete: if isOwner(resource.data.businessId) || isRequestingUserAdmin();
    }
    
    match /marketBanners/{bannerId} {
        allow get, list: if true;
        allow write: if isRequestingUserAdmin();
    }

    match /marketCategories/{categoryId} {
        allow get, list: if true;
        allow write: if isRequestingUserAdmin();
    }
    
    match /reviews/{reviewId} {
      allow read, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isRequestingUserAdmin();
    }

    match /blogs/{blogId} {
        allow get: if resource.data.isPublished == true || isRequestingUserAdmin();
        allow list: if true; 
        allow write: if isRequestingUserAdmin(); 
    }

    // --- SUPPORT CHAT ---
    match /supportTickets/{ticketId} {
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow read, write, list, delete: if isRequestingUserAdmin();
    }
    
    match /chatConversations/{conversationId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isRequestingUserAdmin();
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid) || isRequestingUserAdmin();
      allow list: if isRequestingUserAdmin();
      allow delete: if isRequestingUserAdmin();

      match /messages/{messageId} {
        allow create: if (isSignedIn() && get(parent).data.userId == request.auth.uid) || isRequestingUserAdmin();
        allow read, list: if (isSignedIn() && get(parent).data.userId == request.auth.uid) || isRequestingUserAdmin();
        allow update, delete: if isRequestingUserAdmin();
      }
    }
    
    match /supportAgents/{agentId} {
        allow read: if true;
        allow write: if isRequestingUserAdmin();
    }

    match /businessVerifications/{businessId} {
        allow read, create, update: if isOwner(businessId) || isRequestingUserAdmin();
        allow list, delete: if isRequestingUserAdmin();
    }
  }
}
