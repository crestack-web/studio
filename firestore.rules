
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getRole() {
        // Safely get user role, returns null if not found or no role.
        let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
        if (userDoc != null && 'role' in userDoc.data) {
            return userDoc.data.role;
        }
        return null;
    }

    function isAdmin() {
        return isSignedIn() && getRole() == 'Admin';
    }
    
    function isBusinessOwner(businessId) {
      // Check that the user making the request is the owner of the business document.
      // This is a robust way to check ownership without relying on a user's profile doc.
      let businessDoc = get(/databases/$(database)/documents/businesses/$(businessId));
      return businessDoc != null && businessDoc.data.ownerId == request.auth.uid;
    }


    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      // Owners can update their profile, but NOT change their businessId once set.
      // Admins can update anything. This prevents users from hijacking other businesses.
      allow update: if (isOwner(userId) && (resource.data.businessId == null || request.resource.data.businessId == resource.data.businessId)) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /businesses/{businessId} {
      // The owner of the business document can read/write it. Admins too.
      allow read, write: if isBusinessOwner(businessId) || isAdmin();
    }
    
    match /businessProfiles/{businessId} {
      // This collection is for public marketplace data.
      allow get, list: if true;
      
      // Only the business owner or an admin can write to the public profile.
      allow write: if isBusinessOwner(businessId) || isAdmin();
    }

    // Generic rules for most business-owned subcollections.
    // Only the business owner or an admin should be able to access these.
    match /businesses/{businessId}/{subcollection}/{docId} 
        where subcollection in ['inventory', 'products', 'sales', 'expenses', 'transactions'] {
      allow read, write: if isBusinessOwner(businessId) || isAdmin();
    }

    // Special, more permissive rule for the 'orders' subcollection.
    match /businesses/{businessId}/orders/{orderId} {
      // Allow authenticated users to create orders for themselves.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Allow the customer who created the order OR the business owner OR an admin to read/update/delete it.
      allow get, update, delete: if isBusinessOwner(businessId) || isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Business owner or admin can list all orders.
      allow list: if isBusinessOwner(businessId) || isAdmin();
    }

    match /marketProducts/{marketProductId} {
      // Publicly readable for the market.
      allow get, list: if true;
      
      // Allow creation/update if the user is the owner of the business they are listing for.
      allow create, update: if isBusinessOwner(request.resource.data.businessId) || isAdmin();
      
      // Allow deletion if the user owns the business the product belongs to.
      allow delete: if isBusinessOwner(resource.data.businessId) || isAdmin();
    }
    
    match /blogs/{blogId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /supportTickets/{ticketId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
