
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Securely checks if the user has an admin role.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Securely checks if the user owns the specified business.
    // IMPORTANT: This performs a 'get' which costs 1 read operation. Use judiciously.
    function isOwner(businessId) {
      return businessId != null &&
             isSignedIn() &&
             exists(/databases/$(database)/documents/businesses/$(businessId)) &&
             get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    // Securely checks if the user is a staff member of the specified business.
    function isStaff(businessId) {
      return businessId != null &&
             isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == businessId;
    }
    
    // Gets the business ID for the currently authenticated user from their user profile.
    function getBusinessIdForCurrentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId;
    }


    // --- USER & ADMIN PROFILES ---
    match /users/{userId} {
      // Any authenticated user can create their own profile.
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Users can read their own profile. Admins can read any profile.
      allow get: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      
      // Users can update their own profile, but cannot change their role. Admins can update anything.
      allow update: if (isSignedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role) || isAdmin();

      // Deleting users and listing all users is an admin-only action.
      allow delete, list: if isAdmin();
    }
    
    // Admin collection is read-only for other admins, and not publicly writable.
    // Admins must be added manually in the Firestore console.
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }


    // --- BUSINESS DATA ---
    match /businesses/{businessId} {
      // The business owner, staff of that business, or an admin can read the business document.
      allow get: if isOwner(businessId) || isStaff(businessId) || isAdmin();
      
      // A user can create a business if they set themselves as the owner.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      // Only the business owner or an admin can update or delete the business.
      allow update, delete: if isOwner(businessId) || isAdmin();
      
      // Listing all businesses is restricted to admins for performance and security.
      allow list: if isAdmin();
    }

    // Business Subcollections
    match /businesses/{businessId}/inventory/{docId} {
      allow read, write: if isOwner(businessId) || isStaff(businessId) || isAdmin();
    }
    match /businesses/{businessId}/products/{docId} {
      allow read, write: if isOwner(businessId) || isStaff(businessId) || isAdmin();
    }
    match /businesses/{businessId}/sales/{docId} {
      allow read, write: if isOwner(businessId) || isStaff(businessId) || isAdmin();
    }
    match /businesses/{businessId}/expenses/{docId} {
      allow read, write: if isOwner(businessId) || isStaff(businessId) || isAdmin();
    }
    match /businesses/{businessId}/transactions/{docId} {
      allow read, write: if isOwner(businessId) || isStaff(businessId) || isAdmin();
    }


    // --- PUBLIC MARKETPLACE & ORDERS ---
    
    // Publicly readable business profiles for the market.
    match /businessProfiles/{businessId} {
      allow get, list: if true;
      // Only the owner or an admin can create or modify the public profile.
      allow write: if isOwner(businessId) || isAdmin();
    }
    
    // Publicly readable product listings.
    match /marketProducts/{productId} {
      // Anyone can view and list products.
      allow get, list: if true;
      
      // Create: User must be the owner of the business ID in the new product.
      allow create: if isOwner(request.resource.data.businessId) || isAdmin();

      // Update: User must be owner, and cannot change the business ID.
      allow update: if (isOwner(resource.data.businessId) && request.resource.data.businessId == resource.data.businessId) || isAdmin();
      
      // Delete: User must be the owner of the business ID of the product being deleted.
      allow delete: if isOwner(resource.data.businessId) || isAdmin();
    }
    

    // --- CONTENT & SUPPORT ---
    
    // Blog posts
    match /blogs/{blogId} {
      // Allow public list of published posts, and admin list of any posts.
      allow list: if request.query.where.isPublished == true || isAdmin();

      // Published posts are public. Admins can read all posts.
      allow get: if resource.data.isPublished == true || isAdmin();
      
      // Only admins can create, update, or delete blog posts.
      allow write: if isAdmin();
    }

    // Support Tickets
    match /supportTickets/{ticketId} {
      // Any signed-in user can create a support ticket for themselves.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // The user who created the ticket and admins can view or update it.
      allow get, update: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      
      // Only admins can list or delete tickets.
      allow list, delete: if isAdmin();
    }
  }
}
