
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      // NOTE: The check for `getUserData().role == 'Admin'` was removed to prevent a recursive loop
      // where the rule for reading a user's role depended on already knowing the user's role.
      // This is now the single source of truth for admin privileges in security rules.
      return isSignedIn() && request.auth.token.email == 'crestack@gmail.com';
    }

    function isOwner(businessId) {
      if (businessId == null || !isSignedIn()) {
        return false;
      }
      let businessDocPath = /databases/$(database)/documents/businesses/$(businessId);
      if (!exists(businessDocPath)) {
          return false;
      }
      let businessDoc = get(businessDocPath);
      return 'ownerId' in businessDoc.data && businessDoc.data.ownerId == request.auth.uid;
    }

    function isBusinessMember(businessId) {
      let userData = getUserData();
      return isSignedIn() && userData.businessId == businessId;
    }

    // --- MAIN COLLECTIONS ---
    match /users/{userId} {
      // Signup: A user can create their own profile document.
      allow create: if isUserOwner(userId) && request.resource.data.id == userId;
      
      // Read/Update: A user can only read and update their own profile. Admins can read any user.
      allow get: if isUserOwner(userId) || isAdmin();
      allow update: if isUserOwner(userId) 
                      && request.resource.data.role == resource.data.role
                      && request.resource.data.businessId == resource.data.businessId;
      
      // Allow users to list other users only if they are querying for their own business.
      allow list: if (isSignedIn() && request.query.businessId == getUserData().businessId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /businesses/{businessId} {
      // Signup: A user can create a business if they are the owner.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      // Access: Business members can read, only owners can update.
      allow get: if isBusinessMember(businessId);
      allow update: if isOwner(businessId);
      
      allow list, delete: if false;

      // Subcollections
      match /products/{docId} { allow read, write: if isBusinessMember(businessId); }
      match /sales/{docId} { allow read, write: if isBusinessMember(businessId); }
      match /expenses/{docId} { allow read, write: if isBusinessMember(businessId); }
      match /transactions/{docId} { allow read, write: if isBusinessMember(businessId); }
      match /invitations/{invitationId} { 
        allow read, write: if isSignedIn() && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
      }

      match /orders/{orderId} {
        allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
        allow get: if (isSignedIn() && resource.data.buyerId == request.auth.uid) || isBusinessMember(businessId);
        allow update, list: if isBusinessMember(businessId);
        allow delete: if false;
      }
    }
    
    // --- MARKETPLACE & OTHER COLLECTIONS ---
    match /businessProfiles/{businessId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isOwner(businessId) && request.resource.data.ownerId == resource.data.ownerId) || isAdmin();
      allow delete: if isOwner(businessId) || isAdmin();
    }
    
    match /marketProducts/{productId} {
      allow get, list: if true;
      allow create: if isOwner(request.resource.data.businessId);
      allow update: if isOwner(resource.data.businessId) || isAdmin();
      allow delete: if isOwner(resource.data.businessId) || isAdmin();
    }
    
    match /marketBanners/{bannerId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /marketCategories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /blogs/{blogId} {
        allow read, list: if true;
        allow write: if isAdmin(); 
    }

    match /supportTickets/{ticketId} {
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow read, write, list, delete: if isAdmin();
    }
  }
}
