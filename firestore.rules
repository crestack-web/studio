rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default: Public read access, authenticated write access.
    // This is a temporary, permissive state for development.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- BACKEND-ONLY WRITES ---
    // The following collections should only be written to by a trusted backend.
    match /subscriptionTransactions/{transactionId} {
      allow write: if false;
    }
    
    match /businesses/{businessId}/paymentTransactions/{transactionId} {
      allow write: if false;
    }
    
    match /businesses/{businessId}/payouts/{payoutId} {
      allow write: if false;
    }
  }
}
