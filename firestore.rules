rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is merchant owner
    function isMerchantOwner(merchantId) {
      return isAuthenticated() && 
             request.auth.uid == get(/databases/$(database)/documents/merchants/$(merchantId)).data.ownerId;
    }
    
    // Helper function to check if user is staff member
    function isStaffMember(merchantId) {
      return isAuthenticated() && 
             request.auth.uid in get(/databases/$(database)/documents/merchants/$(merchantId)).data.staff;
    }
    
    // Helper function to check if user has access to merchant data
    function hasMerchantAccess(merchantId) {
      return isMerchantOwner(merchantId) || isStaffMember(merchantId);
    }
    
    // =====================
    // USERS COLLECTION
    // =====================
    match /users/{userId} {
      // Allow read if user is authenticated and it's their own data
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow user to create their own profile during signup
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId;
      
      // Allow user to update their own data (including subscription)
      allow update: if isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }
    
    // =====================
    // MERCHANTS COLLECTION (Business profiles)
    // =====================
    match /merchants/{merchantId} {
      // Allow read if user is authenticated and is the owner
      allow read: if isMerchantOwner(merchantId);

      // Allow creation of merchant document during signup
      // User can create their own business profile
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId;

      // Allow write only if user is owner
      allow update, delete: if isMerchantOwner(merchantId);

      // =====================
      // SALES SUBCOLLECTION
      // =====================
      match /sales/{saleId} {
        allow read: if hasMerchantAccess(resource.data.merchantId);
        allow create: if isMerchantOwner(request.resource.data.merchantId);
        allow update: if isMerchantOwner(resource.data.merchantId);
        allow delete: if isMerchantOwner(resource.data.merchantId);
      }

      // =====================
      // PRODUCTS SUBCOLLECTION
      // =====================
      match /products/{productId} {
        allow read: if hasMerchantAccess(resource.data.merchantId);
        allow create: if isMerchantOwner(request.resource.data.merchantId);
        allow update: if isMerchantOwner(resource.data.merchantId);
        allow delete: if isMerchantOwner(resource.data.merchantId);
      }

      // =====================
      // EXPENSES SUBCOLLECTION
      // =====================
      match /expenses/{expenseId} {
        allow read: if hasMerchantAccess(resource.data.merchantId);
        allow create: if isMerchantOwner(request.resource.data.merchantId);
        allow update: if isMerchantOwner(resource.data.merchantId);
        allow delete: if isMerchantOwner(resource.data.merchantId);
      }

      // =====================
      // STAFF SUBCOLLECTION
      // =====================
      match /staff/{staffId} {
        allow read: if isMerchantOwner(resource.data.merchantId);
        allow write: if isMerchantOwner(request.resource.data.merchantId);
      }
    }

    // =====================
    // BUSINESSES COLLECTION (Alternative business data structure)
    // =====================
    match /businesses/{businessId} {
      // Allow read if user is authenticated and is the owner
      allow read: if isMerchantOwner(businessId);

      // Allow creation of business document during signup
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId;

      // Allow write only if user is owner
      allow update, delete: if isMerchantOwner(businessId);

      // =====================
      // BRANCHES SUBCOLLECTION
      // =====================
      match /branches/{branchId} {
        // Allow read if user is authenticated and owns the parent business
        allow read: if isMerchantOwner(businessId);
        
        // Allow create if user is owner and on Pro plan
        allow create: if isMerchantOwner(request.resource.data.businessId) &&
                         request.resource.data.plan in ['pro'];
        
        // Allow update/delete if user is owner
        allow update, delete: if isMerchantOwner(businessId);
        
        // Branch staff subcollection
        match /staff/{staffId} {
          allow read: if hasMerchantAccess(businessId);
          allow write: if isMerchantOwner(businessId);
        }
        
        // Branch sales subcollection
        match /sales/{saleId} {
          allow read: if hasMerchantAccess(businessId);
          allow create: if hasMerchantAccess(businessId);
          allow update, delete: if hasMerchantAccess(businessId);
        }
        
        // Branch products subcollection
        match /products/{productId} {
          allow read: if hasMerchantAccess(businessId);
          allow create: if hasMerchantAccess(businessId);
          allow update, delete: if hasMerchantAccess(businessId);
        }
        
        // Branch expenses subcollection
        match /expenses/{expenseId} {
          allow read: if hasMerchantAccess(businessId);
          allow create: if hasMerchantAccess(businessId);
          allow update, delete: if hasMerchantAccess(businessId);
        }
      }

      // =====================
      // SALES SUBCOLLECTION
      // =====================
      match /sales/{saleId} {
        allow read: if hasMerchantAccess(resource.data.businessId);
        allow create: if isMerchantOwner(request.resource.data.businessId);
        allow update: if isMerchantOwner(resource.data.businessId);
        allow delete: if isMerchantOwner(resource.data.businessId);
      }

      // =====================
      // PRODUCTS SUBCOLLECTION
      // =====================
      match /products/{productId} {
        allow read: if hasMerchantAccess(resource.data.businessId);
        allow create: if isMerchantOwner(request.resource.data.businessId);
        allow update: if isMerchantOwner(resource.data.businessId);
        allow delete: if isMerchantOwner(resource.data.businessId);
      }

      // =====================
      // EXPENSES SUBCOLLECTION
      // =====================
      match /expenses/{expenseId} {
        allow read: if hasMerchantAccess(resource.data.businessId);
        allow create: if isMerchantOwner(request.resource.data.businessId);
        allow update: if isMerchantOwner(resource.data.businessId);
        allow delete: if isMerchantOwner(resource.data.businessId);
      }

      // =====================
      // STAFF SUBCOLLECTION
      // =====================
      match /staff/{staffId} {
        allow read: if isMerchantOwner(resource.data.businessId);
        allow write: if isMerchantOwner(request.resource.data.businessId);
      }
    }
    
    // =====================
    // AI CONVERSATIONS (for MO chat history)
    // =====================
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
    }
  }
}