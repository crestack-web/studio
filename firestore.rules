
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(businessId) {
      // Add a guard against null or empty businessId to prevent crashes.
      if (businessId == null || businessId == '') {
        return false;
      }
      // Helper to safely check if the current user owns the specified business.
      // This is safe because it reads from /users and /businesses, which have their own security rules.
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let businessPath = /databases/$(database)/documents/businesses/$(businessId);

      return isSignedIn() &&
             exists(userPath) && get(userPath).data.businessId == businessId &&
             exists(businessPath) && get(businessPath).data.ownerId == request.auth.uid;
    }

    function isAdmin() {
      // Safely check if the current user has an 'Admin' role.
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // --- COLLECTION RULES ---

    // USER-RELATED COLLECTIONS
    match /users/{userId} {
      // CRITICAL FIX: Break recursive loop.
      // An admin's permission to read any user document is checked directly,
      // while a regular user can only read their own document.
      // When the isAdmin() check triggers a get() on the admin's own user document,
      // the second part of this rule (request.auth.uid == userId) will pass,
      // successfully terminating the rule evaluation and preventing a loop.
      allow get: if isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')
        || request.auth.uid == userId
      );
      
      // Listing users is an admin-only action.
      allow list: if isAdmin();

      // Any authenticated user can create their own profile.
      allow create: if isSignedIn() && request.auth.uid == userId;

      // An admin can update any user. A user can update their own profile but cannot change their role or businessId.
      allow update: if (isSignedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.businessId == resource.data.businessId) || isAdmin();
      
      // Only admins can delete users.
      allow delete: if isAdmin();
    }

    // BUSINESS-RELATED COLLECTIONS
    match /businesses/{businessId} {
        // An owner, staff of that business, or an admin can read the main business document.
        allow get: if (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == businessId) || isAdmin();
        
        // A new business can only be created by a signed-in user who sets themselves as the owner.
        allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
        
        // Only the business owner or an admin can update or delete the business document.
        allow update, delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();

        // Listing all businesses is an admin-only action for security.
        allow list: if isAdmin();
    }

    match /businessProfiles/{businessId} {
      // Publicly readable for the marketplace.
      allow get;
      
      // An owner or admin must create the public profile.
      allow create, update, delete: if isOwner(businessId) || isAdmin();
    }
    
    // Subcollections within a business. Only the owner or an admin can access.
    match /businesses/{businessId}/{subcollection}/{docId} 
        where subcollection in ['inventory', 'products', 'sales', 'expenses', 'transactions'] {
      allow read, write: if isOwner(businessId) || isAdmin();
    }

    // MARKETPLACE & ORDER COLLECTIONS
    match /marketProducts/{productId} {
      // Anyone can see active products.
      allow get: if resource.data.status == 'active';
      // Anyone can list products to filter on the client-side.
      allow list: if true; 
      // Only the business owner or an admin can create/manage market products.
      allow create, update, delete: if isOwner(request.resource.data.businessId) || isAdmin();
    }
    
    match /orders/{orderId} {
      // An order can only be created by the authenticated buyer.
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      
      // An order can be read by the buyer, the seller (owner), or an admin.
      allow get: if (isSignedIn() && resource.data.buyerId == request.auth.uid) || isOwner(resource.data.sellerBusinessId) || isAdmin();
      
      // Orders can only be listed if filtered by the seller's business ID, for the owner or an admin to view.
      allow list: if (request.query.sellerBusinessId != null && isOwner(request.query.sellerBusinessId)) || isAdmin();
      
      // Only the seller (owner) or an admin can update an order's status.
      allow update: if isOwner(resource.data.sellerBusinessId) || isAdmin();
      
      // Only admins can delete orders.
      allow delete: if isAdmin();
    }

    // CONTENT & SUPPORT COLLECTIONS
    match /blogs/{blogId} {
      // Published blogs are public.
      allow get: if resource.data.isPublished == true;
      allow list: if true; // Allow listing all blogs for the main blog page
      
      // Only admins can manage blog content.
      allow create, update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      // The user who created the ticket or an admin can view/update it.
      allow get, update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      // Any signed-in user can create a support ticket.
      allow create: if isSignedIn();
      
      // Only admins can list or delete tickets.
      allow list, delete: if isAdmin();
    }
  }
}
