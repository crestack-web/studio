rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is business owner
    function isBusinessOwner(businessId) {
      return isAuthenticated() && 
             request.auth.uid == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId;
    }
    
    // Helper function to check if user is staff member of a business
    function isBusinessStaff(businessId) {
      return isAuthenticated() && 
             request.auth.uid in get(/databases/$(database)/documents/businesses/$(businessId)).data.staffIds;
    }
    
    // Helper function to check if user has access to business data
    function hasBusinessAccess(businessId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == businessId;
    }
    
    // Helper function to check if user is staff via user document
    function isStaffViaUserDoc(businessId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == businessId &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth.token.email in ['taheeratorganic@gmail.com', 'sxeedtxheer@gmail.com', 'admin@busmo.io', 'majnuncode@gmail.com'];
    }
    
    // =====================
    // USERS COLLECTION
    // =====================
    match /users/{userId} {
      // Allow read for authenticated user reading their own data
      // Allow read for admin users
      allow read: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      
      // Allow user to create their own profile during signup
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow user to update their own data (including subscription and credits)
      // Allow admin to update user data
      allow update: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();

      // =====================
      // MO MESSAGES SUBCOLLECTION (for Ask MO chat history)
      // =====================
      match /mo_messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }

      // =====================
      // MO CONVERSATIONS SUBCOLLECTION (for Ask MO conversation history)
      // =====================
      match /mo_conversations/{conversationId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }
      
      // =====================
      // PAGE VISITS SUBCOLLECTION (for user activity tracking)
      // =====================
      match /pageVisits/{pageVisitId} {
        allow read: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAdmin(); // Only admins can delete page visit records
      }
    }
    
    // =====================
    // STORE INDEX (slug → businessId mapping for O(1) public lookup)
    // =====================
    match /storeIndex/{storeSlug} {
      // Anyone can read — needed for public storefront routing
      allow read: if true;
      // Only authenticated business members can write
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // =====================
    // BUSINESSES COLLECTION (Main business data structure)
    // =====================
    match /businesses/{businessId} {
      // Temporarily allow read for any authenticated user for debugging
      allow read: if isAuthenticated() || isAdmin();

      // Allow creation if user is authenticated
      allow create: if isAuthenticated();

      // Allow write if user has access to this business
      allow update, delete: if hasBusinessAccess(businessId) || isAdmin();

      // =====================
      // MO SELL — STORE CONFIG
      // =====================
      match /store/{configDoc} {
        // Public read for storefront (anyone can fetch store config by slug)
        allow read: if true;
        // Only business owner/staff can write
        allow create, update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // MO SELL — STORE PRODUCTS
      // =====================
      match /storeProducts/{productId} {
        // Public read so storefront can list products
        allow read: if true;
        allow create, update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // MO SELL — STORE COLLECTIONS
      // =====================
      match /storeCollections/{collectionId} {
        // Public read for storefront collection pages
        allow read: if true;
        allow create, update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // MO SELL — STORE ORDERS
      // =====================
      match /storeOrders/{orderId} {
        // Owner/staff can read all orders
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        // Orders are created by server-side Integration Bridge (Admin SDK), not client
        allow create: if isAdmin();
        // Owner/staff can update (e.g. add tracking number, change status)
        allow update: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // MO SELL — CHECKOUT SESSIONS
      // =====================
      match /checkoutSessions/{sessionId} {
        // Anyone can create a checkout session (unauthenticated customers)
        allow create: if true;
        // Public read needed for the /order/pending polling page
        allow read: if true;
        // Only server (Admin SDK) updates sessions after payment confirmation
        allow update: if isAdmin();
        allow delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // MO SELL — STORE ANALYTICS
      // =====================
      match /storeAnalytics/{eventId} {
        // Anyone can write analytics events (storefront visitors)
        allow create: if true;
        // Only owner/staff/admin can read analytics
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // MO SELL — SHIPPING ZONES
      // =====================
      match /storeShippingZones/{zoneId} {
        // Public read so checkout page can list zones
        allow read: if true;
        allow create, update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // NOTIFICATIONS SUBCOLLECTION
      // =====================
      match /notifications/{notifId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow update: if hasBusinessAccess(businessId) || isAdmin();
        allow delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // CUSTOMERS SUBCOLLECTION (used by Integration Bridge)
      // =====================
      match /customers/{customerId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow update: if hasBusinessAccess(businessId) || isAdmin();
        allow delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // PROFILE SUBCOLLECTION
      // =====================
      match /profile/{profileId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isAdmin();
        allow update: if hasBusinessAccess(businessId) || isAdmin();
        allow delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // BRANCHES SUBCOLLECTION
      // =====================
      match /branches/{branchId} {
        // Allow read if user has access to parent business
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        
        // Allow create if user has access to parent business
        allow create: if hasBusinessAccess(businessId) || isAdmin();
        
        // Allow update/delete if user has access to parent business
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
        
        // Branch staff subcollection
        match /staff/{staffId} {
          allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
          allow write: if hasBusinessAccess(businessId) || isAdmin();
        }
        
        // Branch sales subcollection
        match /sales/{saleId} {
          allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
          allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
          allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
        }
        
        // Branch products subcollection
        match /products/{productId} {
          allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
          allow create: if hasBusinessAccess(businessId) || isAdmin();
          allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
        }
        
        // Branch expenses subcollection
        match /expenses/{expenseId} {
          allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
          allow create: if hasBusinessAccess(businessId) || isAdmin();
          allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
        }
      }

      // =====================
      // SALES SUBCOLLECTION
      // =====================
      match /sales/{saleId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // PRODUCTS SUBCOLLECTION
      // =====================
      match /products/{productId} {
        // Temporarily allow read for any authenticated user for debugging
        allow read: if isAuthenticated() || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isAdmin();
        allow update: if hasBusinessAccess(businessId) || isAdmin();
        allow delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // EXPENSES SUBCOLLECTION
      // =====================
      match /expenses/{expenseId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isAdmin();
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // STAFF SUBCOLLECTION
      // =====================
      match /staff/{staffId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow write: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // SUPPLIERS SUBCOLLECTION
      // =====================
      match /suppliers/{supplierId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isAdmin();
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // PURCHASES SUBCOLLECTION
      // =====================
      match /purchases/{purchaseId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isAdmin();
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // STOCK RECEIPTS SUBCOLLECTION
      // =====================
      match /stockReceipts/{receiptId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // BANK ACCOUNTS SUBCOLLECTION
      // =====================
      match /bankAccounts/{accountId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isAdmin();
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // BANK TRANSACTIONS SUBCOLLECTION
      // =====================
      match /bankTransactions/{transactionId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }
      
      // =====================
      // ATTENDANCE SUBCOLLECTION
      // =====================
      match /attendance/{attendanceId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow update: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow delete: if hasBusinessAccess(businessId) || isAdmin();
      }
      
      // =====================
      // CONVERSATIONS SUBCOLLECTION (for staff messaging)
      // =====================
      match /conversations/{conversationId} {
        // Allow read for business owner and staff
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        
        // Allow create for business owner and staff
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        
        // Allow update for business owner and staff
        allow update: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        
        // Allow delete only for business owner
        allow delete: if isBusinessOwner(businessId) || isAdmin();
      }

      // =====================
      // CREDIT CUSTOMERS SUBCOLLECTION (for credit tracking)
      // =====================
      match /credit_customers/{customerId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // CREDIT TRANSACTIONS SUBCOLLECTION (for credit transaction history)
      // =====================
      match /credit_transactions/{transactionId} {
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // CASH FLOW SUBCOLLECTION (for tracking money in/out)
      // =====================
      match /cashFlow/{flowId} {
        // Temporarily allow read for any authenticated user for debugging
        allow read: if isAuthenticated() || isAdmin();
        
        // Allow create for business owner and staff
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        
        // Allow update/delete only for business owner
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // SUPPLIER CREDIT SUBCOLLECTION (for tracking supplier credit)
      // =====================
      match /supplier_credit/{creditId} {
        // Temporarily allow read for any authenticated user for debugging
        allow read: if isAuthenticated() || isAdmin();
        
        // Allow create for business owner and staff
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        
        // Allow update/delete only for business owner
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // CASH RECONCILIATIONS SUBCOLLECTION (for cash reconciliation tracking)
      // =====================
      match /cashReconciliations/{reconciliationId} {
        // Allow read for business owner and staff
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        
        // Allow create for business owner and staff
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        
        // Allow update/delete only for business owner
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // STAFF ACTIVITY SUBCOLLECTION (for monitoring staff actions)
      // =====================
      match /staffActivity/{activityId} {
        // Temporarily allow read for any authenticated user for debugging
        allow read: if isAuthenticated() || isAdmin();
        
        // Allow create for business owner and staff (auto-generated on actions)
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        
        // Allow update/delete only for business owner
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // AI CONVERSATIONS SUBCOLLECTION (for Ask MO chat persistence)
      // =====================
      match /aiConversations/{conversationId} {
        allow read, write: if hasBusinessAccess(businessId) || isAdmin();
      }

      // =====================
      // AUDIT TRAIL SUBCOLLECTION (for tracking all changes)
      // =====================
      match /auditTrail/{auditId} {
        // Allow read for business owner and staff
        allow read: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        
        // Allow create for business owner and staff (auto-generated on changes)
        allow create: if hasBusinessAccess(businessId) || isBusinessStaff(businessId) || isStaffViaUserDoc(businessId) || isAdmin();
        
        // Allow update/delete only for business owner
        allow update, delete: if hasBusinessAccess(businessId) || isAdmin();
      }
    }
    
    // =====================
    // STATEMENTS COLLECTION (for verify statement page)
    // =====================
    match /statements/{statementId} {
      // Allow read for anyone (public verification)
      allow read: if true;
      
      // Allow write only if authenticated and is the business owner
      allow write: if (isAuthenticated() && 
                    request.auth.uid == resource.data.businessId) || isAdmin();
    }
    
    // =====================
    // AI CONVERSATIONS (for MO chat history)
    // =====================
    match /conversations/{conversationId} {
      allow read: if (isAuthenticated() && 
                     resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if (isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid) || isAdmin();
    }
    
    // =====================
    // UGC CREATORS (creator registration — client SDK writes)
    // Public read so the UGC marketplace/discover pages can list creators for
    // both logged-in and anonymous visitors.
    // =====================
    match /ugcCreators/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // =====================
    // UGC VIDEOS (sample reels — creator uploads via client SDK)
    // Public read so any visitor can preview creator portfolios.
    // =====================
    match /ugcVideos/{videoId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    // =====================
    // UGC ORDERS (brand ↔ creator transactions)
    // =====================
    match /ugcOrders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.brandId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        resource.data.brandId == request.auth.uid
      );
    }

    // =====================
    // REFERRALS COLLECTION (for referral program)
    // =====================
    match /referrals/{referralId} {
      allow read: if (isAuthenticated() && 
                     (resource.data.referrerId == request.auth.uid || 
                      resource.data.referredUserId == request.auth.uid)) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if (isAuthenticated() && resource.data.referrerId == request.auth.uid) || isAdmin();
    }
  }
}