
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Use exists() for safer check before get()
      let adminUserPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && 
             exists(adminUserPath) && 
             'role' in get(adminUserPath).data &&
             get(adminUserPath).data.role == 'Admin';
    }

    // Checks if a user is associated with a business via their user profile.
    function isMemberOfBusiness(businessId) {
        // Safer check: ensure user doc and businessId field exist before access.
        let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
        return isSignedIn() && 
               exists(userDocPath) &&
               'businessId' in get(userDocPath).data &&
               get(userDocPath).data.businessId == businessId;
    }

    // Checks if the user is the actual owner of the business document.
    // This function is costly and should be used sparingly. It requires the rule
    // context to have already granted read access to the business document.
    function isBusinessOwner(businessId) {
      let businessDocPath = /databases/$(database)/documents/businesses/$(businessId);
      return exists(businessDocPath) &&
             'ownerId' in get(businessDocPath).data &&
             get(businessDocPath).data.ownerId == request.auth.uid;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
      allow get, delete: if isOwner(userId) || isAdmin();
      
      // Users can update their own profile, but cannot change an existing businessId.
      // This prevents a user from hijacking another business's read access.
      allow update: if (isOwner(userId) && 
                      (request.resource.data.businessId == resource.data.businessId || resource.data.businessId == null)
                    ) || isAdmin();
      allow list: if isAdmin();
    }

    // Rules for the 'businesses' collection
    match /businesses/{businessId} {
      // Read access is granted if the user's profile links to this business.
      allow get: if isMemberOfBusiness(businessId) || isAdmin();
      
      // Write access is ONLY granted if the `ownerId` on the business document itself matches the user.
      allow create: if isOwner(request.resource.data.ownerId);
      // For update/delete, check ownerId on the existing document. This avoids a costly get() call.
      allow update, delete: if resource.data.ownerId == request.auth.uid || isAdmin();

      allow list: if isAdmin();
    }
    
    // Rules for the 'businessProfiles' collection (Public-facing data)
    match /businessProfiles/{businessId} {
      allow get, list: if true;
      // Allow writes only from authenticated users associated with the business.
      allow write: if isMemberOfBusiness(businessId) || isAdmin();
    }

    // Rules for all subcollections under a business.
    match /businesses/{businessId}/{subcollection}/{docId} {
        allow read: if isMemberOfBusiness(businessId) || isAdmin();
        // Simplified write rule to check for membership, not ownership, to avoid complex get() calls.
        allow write: if isMemberOfBusiness(businessId) || isAdmin();

        // Special case for 'orders' - allow anyone to create an order
        match /orders/{orderId} {
            allow create: if true;
        }
    }

    // Rules for the 'marketProducts' collection
    match /marketProducts/{marketProductId} {
      allow get, list: if true;

      // --- Helper Functions for Market Products ---
      function isSourceProductPublished(businessId, productId) {
        let productPath = /databases/$(database)/documents/businesses/$(businessId)/products/$(productId);
        return exists(productPath) && get(productPath).data.isPublishedToMarket == true;
      }

      function isMarketDataConsistent(incomingData, productId) {
        let productPath = /databases/$(database)/documents/businesses/$(incomingData.businessId)/products/$(productId);
        let businessPath = /databases/$(database)/documents/businesses/$(incomingData.businessId);

        // Check for document existence before accessing data
        return exists(productPath) && exists(businessPath) &&
               get(productPath).data.name == incomingData.productName &&
               get(businessPath).data.businessName == incomingData.businessName &&
               incomingData.productId == productId &&
               incomingData.price == get(productPath).data.price &&
               incomingData.category == get(productPath).data.category &&
               incomingData.description == get(productPath).data.description &&
               incomingData.availableQuantity == get(productPath).data.quantity;
      }
      
      // Allow creation only by a member of the business, and only if the source product is published and data is consistent.
      allow create: if (isMemberOfBusiness(request.resource.data.businessId) &&
                       isSourceProductPublished(request.resource.data.businessId, request.resource.data.productId) &&
                       isMarketDataConsistent(request.resource.data, request.resource.data.productId)) || isAdmin();

      // Allow updates only from a member of the business, ensuring data remains consistent.
      allow update: if (isMemberOfBusiness(resource.data.businessId) &&
                       isSourceProductPublished(request.resource.data.businessId, request.resource.data.productId) &&
                       isMarketDataConsistent(request.resource.data, request.resource.data.productId)) || isAdmin();
      
      // Allow deletion only by a member of the business.
      allow delete: if isMemberOfBusiness(resource.data.businessId) || isAdmin();
    }
    
    // Rules for the 'blogs' collection
    match /blogs/{blogId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Rules for the 'supportTickets' collection
    match /supportTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read, list, update, delete: if isAdmin();
    }
  }
}
