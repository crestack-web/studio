
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Safely checks for admin role. Returns false if user doc or role doesn't exist.
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return isSignedIn() && userDoc != null && userDoc.data.role == 'Admin';
    }
    
    function isBusinessOwner(businessId) {
      // Safely checks if the user owns the business. Returns false if business doc or ownerId doesn't exist.
      let businessDoc = get(/databases/$(database)/documents/businesses/$(businessId));
      return isSignedIn() && businessDoc != null && businessDoc.data.ownerId == request.auth.uid;
    }


    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId;
      // User can update their own profile, but cannot change their businessId once set.
      allow update: if (request.auth.uid == userId && (request.resource.data.businessId == resource.data.businessId || resource.data.businessId == null)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /businesses/{businessId} {
      // Allow get/update/delete only if the user is the owner of the document being accessed.
      // This is non-recursive and safe, checking the document's own data.
      allow get, update, delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      
      // Admin can list all businesses.
      allow list: if isAdmin();
      
      // Allow create if the ownerId in the new document matches the user's UID.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }
    
    match /businessProfiles/{businessId} {
      // Publicly readable for the market
      allow get, list: if true;
      // Allow any signed-in user to create a profile. This is necessary for the initial onboarding batch write.
      allow create: if isSignedIn();
      // Allow update/delete only if the user is the owner of the corresponding business.
      allow update, delete: if isBusinessOwner(businessId) || isAdmin();
    }

    match /businesses/{businessId}/{subcollection}/{docId} 
        where subcollection in ['inventory', 'products', 'sales', 'expenses', 'transactions'] {
      allow get, list: if isBusinessOwner(businessId) || isAdmin();
      allow write: if isBusinessOwner(businessId) || isAdmin();
    }

    match /orders/{orderId} {
        // Buyer can create their own order
        allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
        // Buyer, Seller, or Admin can read
        allow get: if (isSignedIn() && resource.data.buyerId == request.auth.uid) || isBusinessOwner(resource.data.sellerBusinessId) || isAdmin();
        // Seller or Admin can list orders for a specific business
        allow list: if (request.query.sellerBusinessId != null && isBusinessOwner(request.query.sellerBusinessId)) || isAdmin();
        // Buyer can cancel, Seller/Admin can update status
        allow update: if isBusinessOwner(resource.data.sellerBusinessId) || isAdmin() || (isSignedIn() && resource.data.buyerId == request.auth.uid);
        // Only Admin or Seller can delete
        allow delete: if isBusinessOwner(resource.data.sellerBusinessId) || isAdmin();
    }

    match /marketProducts/{marketProductId} {
      // Publicly readable for the market.
      allow get, list: if true;
      
      // Allow creation/update if the user is the owner of the business they are listing for.
      allow create, update: if isBusinessOwner(request.resource.data.businessId) || isAdmin();
      
      // Allow deletion if the user owns the business the product belongs to.
      allow delete: if isBusinessOwner(resource.data.businessId) || isAdmin();
    }
    
    match /blogs/{blogId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /supportTickets/{ticketId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
