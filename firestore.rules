
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Safely checks if the currently authenticated user is an administrator.
    // This function relies on the /users/{userId} rule allowing a user to read their own profile.
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Safely checks if the currently authenticated user is the owner of a specific business.
    // It verifies this by checking the `ownerId` field on the business document itself.
    function isOwner(businessId) {
      let businessPath = /databases/$(database)/documents/businesses/$(businessId);
      return isSignedIn() && exists(businessPath) && get(businessPath).data.ownerId == request.auth.uid;
    }

    // Safely checks if the currently authenticated user is a staff member of a specific business.
    // It verifies this by checking the `businessId` field on the user's own profile.
    function isStaff(businessId) {
       let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
       return isSignedIn() && exists(userPath) && get(userPath).data.businessId == businessId;
    }


    // --- USER PROFILES ---
    match /users/{userId} {
      // Any authenticated user can create their own profile.
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Users can read their own profile. Admins can read any profile.
      allow get: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      
      // Users can update their own profile, but cannot change their role or businessId. Admins can update anything.
      allow update: if (isSignedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.businessId == resource.data.businessId) || isAdmin();

      // Only admins can delete or list users.
      allow delete, list: if isAdmin();
    }


    // --- BUSINESS DATA ---
    match /businesses/{businessId} {
      // The business owner, staff of that business, or an admin can read the business document.
      allow get: if isOwner(businessId) || isStaff(businessId) || isAdmin();
      
      // A user can create a business if they set themselves as the owner.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      // Only the business owner or an admin can update or delete the business.
      allow update, delete: if isOwner(businessId) || isAdmin();
      
      // Listing all businesses is restricted to admins.
      allow list: if isAdmin();
    }

    // Business Subcollections
    match /businesses/{businessId}/{subcollection}/{docId} 
      where subcollection in ['inventory', 'products', 'sales', 'expenses', 'transactions'] {
      // Owner, staff, and admins can read and write to business subcollections.
      allow read, write: if isOwner(businessId) || isStaff(businessId) || isAdmin();
    }


    // --- PUBLIC MARKETPLACE & ORDERS ---
    
    // Publicly readable business profiles for the market.
    match /businessProfiles/{businessId} {
      allow get, list: if true;
      // Only the owner or an admin can create or modify the public profile.
      allow write: if isOwner(businessId) || isAdmin();
    }
    
    // Publicly readable product listings.
    match /marketProducts/{productId} {
      // Anyone can view and list products.
      allow get, list: if true;
      // Only the owner of the business that owns the product, or an admin, can write.
      allow create, update, delete: if isOwner(request.resource.data.businessId) || isAdmin();
    }
    
    // Orders placed by customers.
    match /orders/{orderId} {
      // Any authenticated user can create an order for themselves.
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      
      // The buyer, the seller (business owner), or an admin can read an order.
      allow get: if (isSignedIn() && resource.data.buyerId == request.auth.uid) || isOwner(resource.data.sellerBusinessId) || isAdmin();
      
      // Only the seller (owner) or an admin can update an order (e.g., to change its status).
      allow update: if isOwner(resource.data.sellerBusinessId) || isAdmin();

      // Listing all orders is an admin-only action for security and performance.
      allow list: if isAdmin();
      
      // Deleting orders is an admin-only action.
      allow delete: if isAdmin();
    }

    // --- CONTENT & SUPPORT ---
    
    // Blog posts
    match /blogs/{blogId} {
      // Published posts are public. Admins can read anything.
      allow read: if resource.data.isPublished == true || isAdmin();
      
      // Only admins can create, update, or delete blog posts.
      allow write: if isAdmin();
    }

    // Support Tickets
    match /supportTickets/{ticketId} {
      // Any signed-in user can create a support ticket.
      allow create: if isSignedIn();
      
      // The user who created the ticket and admins can view or update it.
      allow get, update: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      
      // Only admins can list or delete tickets.
      allow list, delete: if isAdmin();
    }
  }
}
