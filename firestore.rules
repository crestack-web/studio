
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      if (!isSignedIn()) {
        return false;
      }
      if (request.auth.token.email == 'crestack@gmail.com') {
        return true;
      }
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      // Check if userDoc exists and has a role property before accessing it
      return userDoc != null && 'role' in userDoc.data && userDoc.data.role == 'Admin';
    }

    function isOwner(businessId) {
      if (!isSignedIn()) { return false; }
      let userDoc = getUserData();
      return userDoc != null && userDoc.businessId == businessId && userDoc.role == 'Owner';
    }

    function isBusinessMember(businessId) {
      if (!isSignedIn()) { return false; }
      let userDoc = getUserData();
      return userDoc != null && userDoc.businessId == businessId;
    }

    // --- MAIN COLLECTIONS ---
    match /users/{userId} {
      allow create: if isUserOwner(userId);
      allow get: if isUserOwner(userId) || isAdmin();
      allow update: if isUserOwner(userId);
      allow list: if isAdmin();
      allow delete: if isAdmin();
    }

    match /businesses/{businessId} {
      allow get: if isBusinessMember(businessId);
      allow create: if isOwner(businessId);
      allow update: if isOwner(businessId);
      allow list, delete: if false;

      // Subcollections
      match /products/{docId} { allow read, write: if isBusinessMember(businessId); }
      match /sales/{docId} { allow read, write: if isBusinessMember(businessId); }
      match /expenses/{docId} { allow read, write: if isBusinessMember(businessId); }
      match /transactions/{docId} { allow read, write: if isBusinessMember(businessId); }
      match /invitations/{invitationId} { allow read, write: if isOwner(businessId); }
      match /orders/{orderId} {
        allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
        allow get: if (isSignedIn() && resource.data.buyerId == request.auth.uid) || isBusinessMember(businessId);
        allow update, list: if isBusinessMember(businessId);
        allow delete: if false;
      }
      match /bankAccount/{accountId} { allow read, write: if isOwner(businessId); }
      match /paymentTransactions/{transactionId} {
          allow read: if isOwner(businessId);
          allow write: if false;
      }
      match /payouts/{payoutId} {
          allow read: if isOwner(businessId);
          allow write: if false;
      }
    }
    
    // --- MARKETPLACE & OTHER COLLECTIONS ---
    match /businessProfiles/{businessId} {
      allow get, list: if true;
      allow create, update, delete: if isOwner(businessId) || isAdmin();
    }
    
    match /marketProducts/{productId} {
      allow get, list: if true;
      allow create: if isOwner(request.resource.data.businessId);
      allow update: if isOwner(resource.data.businessId) || isAdmin();
      allow delete: if isOwner(resource.data.businessId) || isAdmin();
    }
    
    match /marketBanners/{bannerId} {
        allow get, list: if true;
        allow write: if isAdmin();
    }

    match /marketCategories/{categoryId} {
        allow get, list: if true;
        allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /blogs/{blogId} {
        allow get, list: if true; 
        allow write: if isAdmin(); 
    }

    // --- SUPPORT CHAT ---
    match /supportTickets/{ticketId} {
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow read, write, list, delete: if isAdmin();
    }
    
    match /chatConversations/{conversationId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        // Use get(parent) which is more efficient and reliable
        allow create: if (isSignedIn() && get(parent).data.userId == request.auth.uid) || isAdmin();
        allow read, list: if (isSignedIn() && get(parent).data.userId == request.auth.uid) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }
    
    match /supportAgents/{agentId} {
        allow read: if true;
        allow write: if isAdmin();
    }
  }
}
