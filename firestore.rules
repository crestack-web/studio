
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isBusinessOwner(businessId) {
      let userData = getUserData();
      return isSignedIn() && userData.businessId == businessId && userData.role == 'Owner';
    }

    function isBusinessMember(businessId) {
      let userData = getUserData();
      return isSignedIn() && userData.businessId == businessId;
    }

    // --- MAIN COLLECTIONS ---
    match /users/{userId} {
      // Signup: A user can create their own profile document.
      allow create: if isUserOwner(userId) && request.resource.data.id == userId;
      
      // Read/Update: A user can only read and update their own profile.
      // Role or businessId cannot be changed from the client.
      allow get: if isUserOwner(userId);
      allow update: if isUserOwner(userId) 
                      && request.resource.data.role == resource.data.role
                      && request.resource.data.businessId == resource.data.businessId;
      
      allow list, delete: if false;
    }

    match /businesses/{businessId} {
      // Signup: A user can create a business if they are the owner.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      // Access: Business members can read, only owners can update.
      allow get: if isBusinessMember(businessId);
      allow update: if isBusinessOwner(businessId);
      
      allow list, delete: if false;

      // Subcollections
      match /products/{docId} { allow read, write: if isBusinessMember(businessId); }
      match /sales/{docId} { allow read, write: if isBusinessMember(businessId); }
      match /expenses/{docId} { allow read, write: if isBusinessMember(businessId); }
      match /transactions/{docId} { allow read, write: if isBusinessMember(businessId); }

      match /orders/{orderId} {
        allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
        allow get: if (isSignedIn() && resource.data.buyerId == request.auth.uid) || isBusinessMember(businessId);
        allow update, list: if isBusinessMember(businessId);
        allow delete: if false;
      }
    }
    
    // --- MARKETPLACE & OTHER COLLECTIONS ---
    match /businessProfiles/{businessId} {
      allow get, list: if true;
      allow create, update, delete: if isBusinessOwner(businessId);
    }
    
    match /marketProducts/{productId} {
      allow get, list: if true;
      allow create: if isBusinessOwner(request.resource.data.businessId);
      allow update: if isBusinessOwner(resource.data.businessId) || isBusinessOwner(request.resource.data.businessId);
      allow delete: if isBusinessOwner(resource.data.businessId);
    }

    match /reviews/{reviewId} {
      allow read, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /blogs/{blogId} {
        allow read, list: if true;
        allow write: if false; 
    }

    match /supportTickets/{ticketId} {
        allow create: if isSignedIn();
        allow read, write: if false; 
    }
    
    match /invitations/{invitationId} {
      allow get, delete: if isSignedIn() && request.auth.token.email == resource.data.email;
      allow create: if isBusinessOwner(request.resource.data.businessId);
      allow list: if isBusinessMember(request.query.get("businessId"));
    }
  }
}
