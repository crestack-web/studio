
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(businessId) {
      // Helper to safely check if the current user owns the specified business.
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let businessPath = /databases/$(database)/documents/businesses/$(businessId);

      return isSignedIn() &&
             exists(userPath) && get(userPath).data.businessId == businessId &&
             exists(businessPath) && get(businessPath).data.ownerId == request.auth.uid;
    }

    function isAdmin() {
      // Safely check if the current user has an 'Admin' role.
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get, list: if isAdmin();
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Prevent users from changing their own role or businessId after assignment.
      allow update: if (isSignedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.businessId == resource.data.businessId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /businesses/{businessId} {
        allow get: if (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == businessId) || isAdmin();
        allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
        allow update: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
        allow delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
        allow list: if isAdmin();
    }

    match /businessProfiles/{businessId} {
      allow get: if true; // Publicly readable
      allow create: if isSignedIn();
      allow update, delete: if isOwner(businessId) || isAdmin();
    }
    
    match /marketProducts/{productId} {
      allow get: if resource.data.status == 'active';
      allow list: if true; // Allow listing to filter on client
      allow create, update, delete: if isOwner(request.resource.data.businessId) || isAdmin();
    }

    match /businesses/{businessId}/{subcollection}/{docId} 
        where subcollection in ['inventory', 'products', 'sales', 'expenses', 'transactions'] {
      allow read, write: if isOwner(businessId) || isAdmin();
    }
    
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow get: if (isSignedIn() && resource.data.buyerId == request.auth.uid) || isOwner(resource.data.sellerBusinessId) || isAdmin();
      // Secure list queries by enforcing a filter on sellerBusinessId
      allow list: if (request.query.sellerBusinessId != null && isOwner(request.query.sellerBusinessId)) || isAdmin();
      allow update: if isOwner(resource.data.sellerBusinessId) || isAdmin(); // Seller or admin can update status
      allow delete: if isAdmin();
    }

    match /blogs/{blogId} {
      allow get: if resource.data.isPublished == true;
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow get, update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow list, delete: if isAdmin();
    }
  }
}
