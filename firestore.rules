rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =====================================================================
    // TEMPORARY: All helper functions return true because Firebase Auth
    // is no longer used (app migrated to Supabase Auth). To re-secure,
    // change these functions back and deploy firestore.rules.
    // Firebase Admin SDK custom tokens will restore request.auth once
    // credentials are added to the Vercel environment.
    // =====================================================================
    function isAuthenticated() {
      return true;
    }
    
    function isBusinessOwner(businessId) {
      return true;
    }
    
    function isBusinessStaff(businessId) {
      return true;
    }
    
    function hasBusinessAccess(businessId) {
      return true;
    }
    
    function isStaffViaUserDoc(businessId) {
      return true;
    }
    
    function isAdmin() {
      return true;
    }
    
    // =====================
    // USERS COLLECTION
    // =====================
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;

      // MO MESSAGES SUBCOLLECTION
      match /mo_messages/{messageId} {
        allow read, create, update, delete: if true;
      }

      // MO CONVERSATIONS SUBCOLLECTION
      match /mo_conversations/{conversationId} {
        allow read, create, update, delete: if true;
      }
      
      // PAGE VISITS SUBCOLLECTION
      match /pageVisits/{pageVisitId} {
        allow read, create, update, delete: if true;
      }
    }
    
    // =====================
    // STORE INDEX (slug → businessId mapping for O(1) public lookup)
    // =====================
    match /storeIndex/{storeSlug} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // =====================
    // BUSINESSES COLLECTION
    // =====================
    match /businesses/{businessId} {
      allow read, write: if true;

      // MO SELL — STORE CONFIG
      match /store/{configDoc} {
        allow read, write: if true;
      }

      // MO SELL — STORE PRODUCTS
      match /storeProducts/{productId} {
        allow read, write: if true;
      }

      // MO SELL — STORE COLLECTIONS
      match /storeCollections/{collectionId} {
        allow read, write: if true;
      }

      // MO SELL — STORE ORDERS
      match /storeOrders/{orderId} {
        allow read, write: if true;
      }

      // MO SELL — CHECKOUT SESSIONS
      match /checkoutSessions/{sessionId} {
        allow read, write: if true;
      }

      // MO SELL — STORE ANALYTICS
      match /storeAnalytics/{eventId} {
        allow read, write: if true;
      }

      // MO SELL — 7-DAY CONTENT CAMPAIGNS
      match /campaigns/{campaignId} {
        allow read, write: if true;
      }

      // MO SELL — CONTENT CALENDAR
      match /contentCalendar/{postId} {
        allow read, write: if true;
      }

      // MO SELL — SOCIAL PROFILES
      match /socialProfiles/{profileId} {
        allow read, write: if true;
      }

      // MO SELL — SHIPPING ZONES
      match /storeShippingZones/{zoneId} {
        allow read, write: if true;
      }

      // NOTIFICATIONS
      match /notifications/{notifId} {
        allow read, write: if true;
      }

      // CUSTOMERS
      match /customers/{customerId} {
        allow read, write: if true;
      }

      // PROFILE
      match /profile/{profileId} {
        allow read, write: if true;
      }

      // BRANCHES
      match /branches/{branchId} {
        allow read, write: if true;
        
        match /staff/{staffId} { allow read, write: if true; }
        match /sales/{saleId} { allow read, write: if true; }
        match /products/{productId} { allow read, write: if true; }
        match /expenses/{expenseId} { allow read, write: if true; }
      }

      // SALES
      match /sales/{saleId} {
        allow read, write: if true;
      }

      // PRODUCTS
      match /products/{productId} {
        allow read, write: if true;
      }

      // EXPENSES
      match /expenses/{expenseId} {
        allow read, write: if true;
      }

      // STAFF
      match /staff/{staffId} {
        allow read, write: if true;
      }

      // SUPPLIERS
      match /suppliers/{supplierId} {
        allow read, write: if true;
      }

      // PURCHASES
      match /purchases/{purchaseId} {
        allow read, write: if true;
      }

      // STOCK RECEIPTS
      match /stockReceipts/{receiptId} {
        allow read, write: if true;
      }

      // BANK ACCOUNTS
      match /bankAccounts/{accountId} {
        allow read, write: if true;
      }

      // BANK TRANSACTIONS
      match /bankTransactions/{transactionId} {
        allow read, write: if true;
      }
      
      // ATTENDANCE
      match /attendance/{attendanceId} {
        allow read, write: if true;
      }
      
      // CONVERSATIONS (staff messaging)
      match /conversations/{conversationId} {
        allow read, write: if true;
      }

      // CREDIT CUSTOMERS
      match /credit_customers/{customerId} {
        allow read, write: if true;
      }

      // CREDIT TRANSACTIONS
      match /credit_transactions/{transactionId} {
        allow read, write: if true;
      }

      // CASH FLOW
      match /cashFlow/{flowId} {
        allow read, write: if true;
      }

      // SUPPLIER CREDIT
      match /supplier_credit/{creditId} {
        allow read, write: if true;
      }

      // CASH RECONCILIATIONS
      match /cashReconciliations/{reconciliationId} {
        allow read, write: if true;
      }

      // STAFF ACTIVITY
      match /staffActivity/{activityId} {
        allow read, write: if true;
      }

      // AI CONVERSATIONS
      match /aiConversations/{conversationId} {
        allow read, write: if true;
      }

      // AUDIT TRAIL
      match /auditTrail/{auditId} {
        allow read, write: if true;
      }
    }
    
    // =====================
    // STATEMENTS
    // =====================
    match /statements/{statementId} {
      allow read: if true;
      allow write: if true;
    }
    
    // =====================
    // AI CONVERSATIONS (top-level)
    // =====================
    match /conversations/{conversationId} {
      allow read, write: if true;
    }
    
    // =====================
    // UGC CREATORS
    // =====================
    match /ugcCreators/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // =====================
    // UGC VIDEOS
    // =====================
    match /ugcVideos/{videoId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // =====================
    // UGC ORDERS
    // =====================
    match /ugcOrders/{orderId} {
      allow read, write: if true;
    }

    // =====================
    // REFERRALS
    // =====================
    match /referrals/{referralId} {
      allow read, write: if true;
    }
  }
}
