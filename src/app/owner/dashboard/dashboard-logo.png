import React from "react";
import Image from "next/image";
import logoPng from "./dashboard-logo.png";

export function DashboardLogo(props: React.ImgHTMLAttributes<HTMLImageElement>) {
  return (
    <Image
      src={logoPng}
      alt="Logo"
      width={40}
      height={40}
      {...props}
    />
  );
}
